        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%@' ஸ்னாப்ஷாட்டை மீட்டெடுக்க முடியாது. ஏனெனில், அது மெய்நிகர் இயந்திரத்தின் எல்லா இயக்ககங்களையும் உள்ளடக்கவில்லை (எடுத்துக்காட்டாக, ஸ்னாப்ஷாட் எடுத்த பிறகு சேர்க்கப்பட்ட இயக்ககம்)."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
