        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yen diaktifake, kabeh citra drive sing bisa ditulisi bakal dikunci nalika VM mlaku. Citra drive sing mung diwaca ora bakal dikunci."
