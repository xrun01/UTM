          }
        }
      }
    },
    "Do you want to restore the snapshot “%@”? The current state of the virtual machine will be overwritten and any changes that are not saved as a snapshot will be lost." : {
      "localizations" : {
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你要還原快照「%@」嗎？虛擬機的現時狀態將被覆寫，所有未儲存為快照的變更都將遺失。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
