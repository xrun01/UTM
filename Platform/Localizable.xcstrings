        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Det går inte att importera den här virtuella maskinen. Antingen är konfigurationen ogiltig, skapad i en nyare version av UTM eller på en plattform som inte är kompatibel med den här versionen av UTM."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haiwezi kuleta mashine pepe hii. Ama usanidi ni batili, ama umeundwa katika toleo jipya zaidi la UTM au kwenye jukwaa ambalo halioani na toleo hili la UTM."
