        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kan deze VM niet importeren. Ofwel is de configuratie ongeldig, ofwel is ze gemaakt in een nieuwere versie van UTM of op een platform dat niet compatibel is met deze versie van UTM."
