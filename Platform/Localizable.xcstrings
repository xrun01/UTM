    "Closing a VM without properly shutting it down could result in data loss." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي إغلاق آلة افتراضية دون إيقافها بشكل صحيح إلى فقدان البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Schließen einer VM ohne ordnungsgemäßes Herunterfahren kann zu Datenverlust führen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cerrar una máquina virtual sin apagarla correctamente podría provocar la pérdida de datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Virtuaalikoneen sulkeminen sammuttamatta sitä kunnolla voi johtaa tietojen menetykseen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fermer une VM sans l'arrêter correctement peut entraîner une perte de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiusura di una VM senza il corretto spegnimento potrebbe comportare perdita di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンを適切にシステム終了せずに閉じると、データが失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 머신을 정상적으로 종료하지 않고 닫으면 데이터가 손실될 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie maszyny wirtualnej bez poprawnego wyłączenia może poskutkować utratą danych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Закрытие виртуальной машины без ее надлежащего завершения может привести к потере данных."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在未正確關機的情況下關閉虛擬機可能會引致資料遺失。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未正常关机就关闭虚拟机可能会导致数据丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不先正確關機而直接關閉虛擬機器，可能導致資料遺失。"
          }
        }
      }
    },
    "Closing this window will kill the VM." : {
      "comment" : "VMQemuDisplayMetalWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي إغلاق هذه النافذة إلى فرض إنهاء الآلة الافتراضية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Schließen des Fensters wird die VM direkt beenden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cierras esta ventana, se forzará el cierre de la VM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tämän ikkunan sulkeminen tappaa virtuaalikoneen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fermer cette fenêtre forcera la fin du processus de la VM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiusura di questa finestra terminerà la macchina virtuale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このウインドウを閉じると、仮想マシンを強制終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 창을 닫으면 가상 머신을 강제 종료하게 됩니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie tego okna wymusi zakończenie pracy maszyny wirtualnej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Закрытие этого окна приведет к принудительному завершению ВМ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉此視窗會強制結束虛擬機。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "关闭此窗口将终止虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "關閉本視窗將強制中止虛擬機器。"
          }
        }
      }
    },
