    "The recovery IPSW cannot be read. Please select a new IPSW in Boot settings." : {
      "comment" : "UTMAppleVirtualMachine",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die herstel-IPSW kan nie gelees word nie. Kies asseblief 'n nuwe IPSW in die Selflaai-instellings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن قراءة IPSW للاسترداد. يرجى اختيار IPSW جديد في إعدادات التمهيد."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ৰিকভাৰী IPSW পঢ়িব নোৱাৰি। অনুগ্ৰহ কৰি বুট সংহতিত এটা নতুন IPSW নিৰ্বাচন কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bərpa IPSW oxunmur. Yükləmə parametrlərində yeni IPSW seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW аднаўлення не можа быць прачытаны. Выберыце новы IPSW у наладах загрузкі."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW за възстановяване не може да бъде прочетен. Моля, изберете нов IPSW в настройките за зареждане."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "রিকভারি IPSW পড়া যাচ্ছে না। অনুগ্রহ করে বুট সেটিংসে একটি নতুন IPSW নির্বাচন করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW za oporavak se ne može pročitati. Molimo odaberite novi IPSW u postavkama pokretanja."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No es pot llegir l'IPSW de recuperació. Seleccioneu un nou IPSW a la configuració d'arrencada."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili mabasa ang recovery IPSW. Palihug pagpili og bag-ong IPSW sa mga setting sa Boot."
          }
        },
        "cs" : {
