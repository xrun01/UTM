    "Quitting UTM will kill all running VMs." : {
      "comment" : "VMQemuDisplayMetalWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As jy UTM verlaat, word alle lopende VM's beëindig."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنهاء UTM سيؤدي إلى إنهاء جميع الآلات الافتراضية النشطة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ৰ পৰা প্ৰস্থান কৰিলে চলি থকা সকলো VM ৰ প্ৰক্ৰিয়া বলপূৰ্বক সমাপ্ত হ'ব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-dən çıxmaq bütün işləyən VM-ləri məcburi sonlandıracaq."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выхад з UTM прымусова завершыць працу ўсіх запушчаных віртуальных машын."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излизането от UTM ще прекрати принудително всички работещи виртуални машини."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM থেকে প্রস্থান করলে সব চলমান VM জোর করে বন্ধ হয়ে যাবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izlaskom iz UTM-a prisilno će se prekinuti rad svih pokrenutih virtuelnih mašina."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sortiu d'UTM, es forçarà la finalització de totes les màquines virtuals en execució."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang pag-undang sa UTM makapatay sa tanan nga nagdagan nga mga VM."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončením UTM se násilně ukončí všechny běžící virtuální počítače."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd gadael UTM yn lladd pob VM sy'n rhedeg."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du afslutter UTM, tvangsafsluttes alle kørende VM'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mit dem Beenden von UTM werden alle laufenden VMs direkt beendet."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Η έξοδος από το UTM θα τερματίσει αναγκαστικά όλες τις εικονικές μηχανές που εκτελούνται."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si sales de UTM, se forzará el cierre de todas las VMs en ejecución."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-ist väljumine lõpetab kõigi töötavate VM-ide töö sunniviisiliselt."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-tik irteteak exekutatzen ari diren makina birtual guztiak hilko ditu."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خروج از UTM همه ماشین‌های مجازی در حال اجرا را به‌اجبار خاتمه می‌دهد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM:n sulkeminen lopettaa kaikkien käynnissä olevien virtuaalikoneiden prosessit."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapapatay ang lahat ng tumatakbong VM kapag umalis sa UTM."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitter UTM forcera la fin du processus de toutes les VM en cours d’exécution."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao saír de UTM, forzarase o peche de todas as máquinas virtuais en execución."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMમાંથી બહાર નીકળવાથી ચાલી રહેલાં બધાં VM બળપૂર્વક સમાપ્ત થશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "יציאה מ-UTM תסיים בכוח את כל ה-VM הפועלים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM से बाहर निकलने पर सभी चल रही VM बलपूर्वक समाप्त हो जाएँगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zatvaranje UTM-a prisilno će zaustaviti sve pokrenute VM-ove."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az UTM-ből való kilépés azonnal leállítja az összes futó virtuális gépet."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-ից դուրս գալը հարկադրաբար կավարտի բոլոր գործող վիրտուալ մեքենաների աշխատանքը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar dari UTM akan mengakhiri paksa semua VM yang sedang berjalan."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þú hættir í UTM verða ferli allra sýndarvéla í gangi stöðvuð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'uscita da UTM causerà l'interruzione di tutte le VM in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMを終了すると、すべての仮想マシンが強制終了します。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metu saka UTM bakal mungkasi kabeh VM sing mlaku kanthi peksa."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-დან გასვლა ყველა გაშვებული ვირტუალური მანქანის პროცესს იძულებით შეწყვეტს."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM қолданбасынан шықсаңыз, жұмыс істеп тұрған барлық виртуалды машина мәжбүрлеп аяқталады."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ការចាកចេញពី UTM នឹងបញ្ចប់ VM ទាំងអស់ដែលកំពុងដំណើរការដោយបង្ខំ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMನಿಂದ ನಿರ್ಗಮಿಸಿದರೆ ಚಾಲನೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ VMಗಳನ್ನು ಕೊನೆಗೊಳಿಸಲಾಗುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM을 종료하면 실행 중인 모든 가상 머신이 강제 종료됩니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann UTM zougemaach gëtt, ginn all lafend VMs direkt gestoppt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ການອອກຈາກ UTM ຈະສິ້ນສຸດການເຮັດວຽກຂອງ VM ທີ່ກຳລັງແລ່ນທັງໝົດ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išėjus iš „UTM“, visų veikiančių VM veikimas bus priverstinai nutrauktas."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izejot no UTM, visu darbojošos virtuālo mašīnu darbība tiks piespiedu kārtā pārtraukta."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Излегувањето од UTM присилно ќе ги прекине сите виртуелни машини што работат."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM मधून बाहेर पडल्यास सर्व चालू VM संपवले जातील."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Keluar daripada UTM akan menamatkan semua VM yang sedang berjalan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il-ħruġ minn UTM se jittermina l-magni virtwali kollha li qed jaħdmu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM မှ ထွက်ပါက လည်ပတ်နေသော ဗာချွယ်စက်အားလုံးကို အတင်းရပ်စဲမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvis du avslutter UTM, avsluttes alle kjørende VM-er umiddelbart."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM छोड्दा चलिरहेका सबै VM अन्त्य हुनेछन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als u UTM afsluit, worden alle actieve VM's beëindigd."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM କ୍ୱିଟ୍ କଲେ ଚାଲୁଥିବା ସମସ୍ତ VM କିଲ୍ ହୋଇଯିବ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończenie UTM wymusi zamknięcie wszystkich uruchomionych maszyn wirtualnych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sair do UTM forçará o encerramento de todas as VMs em execução."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ieșirea din UTM va opri forțat toate mașinile virtuale care rulează."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выход из UTM приведет к принудительному завершению всех работающих ВМ."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ڇڏڻ سان سڀ هلندڙ VMs ختم ٿي وينديون."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM වෙතින් පිටවීමෙන්, ධාවනය වන සියලු VM අවසන් කෙරේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ukončením UTM sa násilne ukončia všetky spustené virtuálne počítače."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
