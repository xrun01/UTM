        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indien ingeschakeld, worden alle beschrijfbare schijfkopieën vergrendeld wanneer de VM actief is. Alleen-lezen schijfkopieën worden niet vergrendeld."
