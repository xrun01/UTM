    "'%@' is connected to '%@'. Do you want to disconnect it and connect it to this virtual machine instead?" : {
      "comment" : "VMDisplayAppleWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' is gekoppel aan '%2$@'. Wil jy dit ontkoppel en eerder aan hierdie virtuele masjien koppel?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' متصل بـ '%2$@'. هل تريد فصله وتوصيله بهذا الجهاز الظاهري بدلاً من ذلك؟"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' ৰ সৈতে সংযুক্ত। আপুনি ইয়াক বিচ্ছিন্ন কৰিব বিচাৰেনে আৰু ইয়াৰ পৰিবৰ্তে এই ভাৰ্চুৱেল যন্ত্ৰৰ সৈতে সংযোগ কৰিব বিচাৰেনে?"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' ilə bağlıdır. Onu ayırıb əvəzinə bu virtual maşına qoşmaq istəyirsiniz?"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' падлучаны да '%2$@'. Вы хочаце адключыць яго і замест гэтага падключыць да гэтай віртуальнай машыны?"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ е свързан с „%2$@“. Искате ли да го прекъснете и вместо това да го свържете към тази виртуална машина?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' এর সাথে সংযুক্ত। আপনি কি এটি সংযোগ বিচ্ছিন্ন করতে এবং পরিবর্তে এই ভার্চুয়াল মেশিনে সংযোগ করতে চান?"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' je povezan sa '%2$@'. Želite li ga isključiti i umjesto toga spojiti na ovu virtuelnu mašinu?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' està connectat a '%2$@'. Voleu desconnectar-lo i connectar-lo a aquesta màquina virtual?"
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ang '%1$@' konektado sa '%2$@'. Gusto ba nimo nga idiskonekta kini ug ikonektar kini sa kini nga virtual nga makina?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' je připojeno k '%2$@'. Chcete jej odpojit a místo toho připojit k tomuto virtuálnímu počítači?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Mae '%1$@' wedi'i gysylltu â '%2$@'. Ydych chi am ei ddatgysylltu a'i gysylltu â'r peiriant rhithwir hwn yn lle hynny?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' er forbundet til '%2$@'. Vil du afbryde den og forbinde den til denne virtuelle maskine i stedet for?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ ist mit „%2$@“ verbunden. Möchten Sie die Verbindung trennen und stattdessen eine Verbindung zu dieser virtuellen Maschine herstellen?"
          }
        },
        "el" : {
          "stringUnit" : {
