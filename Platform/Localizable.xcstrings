    "Setting up the guest automatically requires a macOS virtual machine and macOS 27 or later on Apple Silicon." : {
      "comment" : "UTMAppleVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يتطلب إعداد الضيف تلقائيًا جهازًا افتراضيًا يعمل بنظام macOS ونظام التشغيل macOS 27 أو إصدار أحدث على Apple Silicon."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Für die automatische Einrichtung des Gastes sind eine virtuelle macOS-Maschine und macOS 27 oder höher auf Apple Silicon erforderlich."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuración automática del invitado requiere una máquina virtual macOS y macOS 27 o posterior en Apple Silicon."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vieraan automaattinen käyttöönotto edellyttää macOS-virtuaalikonetta ja macOS 27:ää tai uudempaa Apple Siliconissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configuration automatique de l'invité nécessite une machine virtuelle macOS et macOS 27 ou version ultérieure sur Apple Silicon."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La configurazione dell'ospite richiede automaticamente una macchina virtuale macOS e macOS 27 o versione successiva su Apple Silicon."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ゲストを自動的にセットアップするには、Apple Silicon 上の macOS 仮想マシンと macOS 27 以降が必要です。"
          }
        },
        "ko" : {
          "stringUnit" : {
