        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatické nastavenie hosťovského systému vyžaduje virtuálny počítač macOS a macOS 27 alebo novší na Macu s čipom Apple Silicon."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Samodejna nastavitev gostujočega sistema zahteva navidezni računalnik macOS in macOS 27 ali novejši na Macu s čipom Apple."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurimi automatik i mysafirit kërkon një makinë virtuale macOS dhe macOS 27 ose më të ri në një Mac me çip Apple."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аутоматско подешавање гостујућег система захтева macOS виртуелну машину и macOS 27 или новији на Mac рачунару са Apple чипом."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att ställa in gästen automatiskt kräver en virtuell macOS-maskin och macOS 27 eller senare på en Mac med Apple-chip."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kusanidi mgeni kiotomatiki kunahitaji mashine pepe ya macOS na macOS 27 au toleo jipya zaidi kwenye Mac yenye Apple silicon."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விருந்தினரைத் தானாக அமைக்க, macOS மெய்நிகர் இயந்திரமும், Apple சிப்பில் இயங்கும் macOS 27 அல்லது அதற்குப் பிந்தைய பதிப்பும் தேவை."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "గెస్ట్‌ను ఆటోమేటిక్‌గా సెటప్ చేయడానికి macOS వర్చువల్ మెషీన్, Apple చిప్ ఉన్న Macలో macOS 27 లేదా తర్వాతి వెర్షన్ అవసరం."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "การตั้งค่าเกสต์โดยอัตโนมัติต้องใช้เครื่องเสมือน macOS และ macOS 27 หรือใหม่กว่าบน Apple Silicon"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuğun otomatik olarak ayarlanması, bir macOS sanal makinesi ve Apple çipli Mac'te macOS 27 veya sonraki bir sürümü gerektirir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для автоматичного налаштування гостьової системи потрібна віртуальна машина macOS і macOS 27 або новішої версії на комп’ютері Mac із чипом Apple."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گیسٹ سسٹم کو خود بخود سیٹ اپ کرنے کے لیے macOS ورچوئل مشین اور Apple چپ والے Mac پر macOS 27 یا بعد کا ورژن ضروری ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehmon tizimni avtomatik sozlash uchun macOS virtual mashinasi va macOS 27 yoki undan keyingi versiyasi o'rnatilgan Apple chipli Mac kerak."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Việc thiết lập khách tự động yêu cầu máy ảo macOS và macOS 27 trở lên trên máy Mac dùng chip Apple silicon."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動設定客體需要 macOS 虛擬機，以及 Apple 晶片上的 macOS 27 或以上版本。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动设置客户机需要 macOS 虚拟机及 Apple 芯片上的 macOS 27 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動設定客體需要 macOS 虛擬機器，以及在 Apple 晶片上執行的 macOS 27 或以上版本。"
          }
        }
      }
    },
