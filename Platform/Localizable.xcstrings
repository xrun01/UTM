    "Choose whether UTM saves the state of running virtual machines or requests that their guest operating systems shut down when UTM quits." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kies of UTM die toestand van lopende virtuele masjiene stoor of versoek dat hul gasbedryfstelsels moet afskakel wanneer UTM stop."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر ما إذا كان UTM يحفظ حالة تشغيل الأجهزة الافتراضية أو يطلب إيقاف تشغيل أنظمة التشغيل الضيف الخاصة بها عند إنهاء UTM."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "UTM এ চলি থকা ভাৰ্চুৱেল মেচিনসমূহৰ অৱস্থা সংৰক্ষণ কৰে নেকি বা অনুৰোধ কৰে যে সিহতৰ অতিথি কাৰ্য্যকৰপ্ৰণালীসমূহ বন্ধ হ'ব যেতিয়া UTM বন্ধ হয়।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "UTM-nin işləyən virtual maşınların vəziyyətini saxlayıb-saxlamadığını və ya UTM çıxdıqda qonaq əməliyyat sistemlərinin bağlanmasını tələb edib-etmədiyini seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберыце, ці захоўвае UTM стан запушчаных віртуальных машын або запытвае адключэнне іх гасцявых аперацыйных сістэм пры выхадзе з UTM."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Изберете дали UTM запазва състоянието на работещи виртуални машини или изисква техните гост операционни системи да се изключат, когато UTM излезе."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "UTM ভার্চুয়াল মেশিন চালানোর অবস্থা সংরক্ষণ করে বা UTM প্রস্থান করার সময় তাদের গেস্ট অপারেটিং সিস্টেমগুলি বন্ধ করার অনুরোধ করে কিনা তা চয়ন করুন৷"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odaberite da li UTM sprema stanje pokrenutih virtuelnih mašina ili zahteva da se njihovi gostujući operativni sistemi isključe kada se UTM zatvori."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trieu si UTM desa l'estat de les màquines virtuals en execució o sol·licita que els seus sistemes operatius convidats es tanquin quan UTM es tanqui."
