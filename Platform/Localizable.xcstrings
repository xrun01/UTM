    "'%@' is connected to '%@'. Do you want to disconnect it and connect it to this virtual machine instead?" : {
      "comment" : "VMDisplayAppleWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' is gekoppel aan '%2$@'. Wil jy dit ontkoppel en eerder aan hierdie virtuele masjien koppel?"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' متصل بـ '%2$@'. هل تريد فصله وتوصيله بهذه الآلة الافتراضية بدلاً من ذلك؟"
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' ৰ সৈতে সংযুক্ত হৈ আছে। আপুনি ইয়াৰ সংযোগ বিচ্ছিন্ন কৰি ইয়াক এই ভাৰ্চুৱেল মেচিনৰ সৈতে সংযোগ কৰিব বিচাৰেনে?"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' cihazı '%2$@' virtual maşınına qoşulub. Onu ayırıb əvəzinə bu virtual maşına qoşmaq istəyirsiniz?"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' падлучаны да '%2$@'. Вы хочаце адключыць яго і замест гэтага падключыць да гэтай віртуальнай машыны?"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ е свързан с „%2$@“. Искате ли да го изключите оттам и вместо това да го свържете към тази виртуална машина?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@'-এর সাথে সংযুক্ত আছে। আপনি কি এটি বিচ্ছিন্ন করে এর বদলে এই ভার্চুয়াল মেশিনের সাথে সংযুক্ত করতে চান?"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' je povezan s '%2$@'. Želite li prekinuti tu vezu i povezati ga s ovom virtuelnom mašinom?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' està connectat a '%2$@'. Voleu desconnectar-lo i connectar-lo a aquesta màquina virtual?"
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang '%1$@' konektado sa '%2$@'. Gusto ba nimo nga idiskonekta kini ug ikonektar hinuon kini niini nga virtual machine?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' je připojeno k '%2$@'. Chcete jej odpojit a místo toho připojit k tomuto virtuálnímu počítači?"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae '%1$@' wedi'i gysylltu â '%2$@'. Ydych chi am ei ddatgysylltu a'i gysylltu â'r peiriant rhithwir hwn yn lle hynny?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' er forbundet til '%2$@'. Vil du afbryde forbindelsen og forbinde den til denne virtuelle maskine i stedet?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ist mit „%2$@“ verbunden. Möchten Sie die Verbindung trennen und stattdessen eine Verbindung zu dieser virtuellen Maschine herstellen?"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το «%1$@» είναι συνδεδεμένο στο «%2$@». Θέλετε να το αποσυνδέσετε και να το συνδέσετε σε αυτήν την εικονική μηχανή;"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "'%1$@' is connected to '%2$@'. Do you want to disconnect it and connect it to this virtual machine instead?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' está conectado a '%2$@'. ¿Quieres desconectarlo y conectarlo a esta máquina virtual?"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” on ühendatud virtuaalmasinaga „%2$@”. Kas soovite selle lahti ühendada ja ühendada hoopis selle virtuaalmasinaga?"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' gailua '%2$@' makina birtualera konektatuta dago. Deskonektatu eta makina birtual honetara konektatu nahi duzu horren ordez?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» به «%2$@» متصل است. آیا می‌خواهید اتصال آن را قطع کنید و به‌جای آن، آن را به این ماشین مجازی متصل کنید؟"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' on yhdistetty kohteeseen '%2$@'. Haluatko katkaista sen yhteyden ja yhdistää sen tähän virtuaalikoneeseen?"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakakonekta ang '%1$@' sa '%2$@'. Gusto mo ba itong idiskonekta at ikonekta na lang sa virtual machine na ito?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' est connecté à '%2$@'. Voulez-vous le déconnecter et le connecter à cette machine virtuelle à la place ?"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' está conectado a '%2$@'. Queres desconectalo e conectalo a esta máquina virtual?"
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' સાથે જોડાયેલ છે. શું તમે તેને ડિસ્કનેક્ટ કરીને તેના બદલે આ વર્ચ્યુઅલ મશીન સાથે કનેક્ટ કરવા માંગો છો?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' מחובר אל '%2$@'. האם ברצונך לנתק אותו ולחבר אותו למכונה הווירטואלית הזו במקום זאת?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' से जुड़ा है। क्या आप इसे डिस्कनेक्ट करके इसके बजाय इस वर्चुअल मशीन से कनेक्ट करना चाहते हैं?"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' je povezan s '%2$@'. Želite li ga odspojiti i umjesto toga spojiti na ovaj virtualni stroj?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) „%1$@” csatlakozik a következőhöz: „%2$@”. Leválasztja, és inkább ehhez a virtuális géphez csatlakoztatja?"
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@»-ը միացված է «%2$@»-ին։ Ցանկանու՞մ եք անջատել այն և դրա փոխարեն միացնել այս վիրտուալ մեքենային։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' terhubung ke '%2$@'. Apakah Anda ingin memutuskan sambungannya dan menyambungkannya ke mesin virtual ini?"
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' er tengt við '%2$@'. Viltu aftengja það og tengja það við þessa sýndarvél í staðinn?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' è connesso a '%2$@'. Vuoi invece disconnetterlo e connetterlo a questa macchina virtuale?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' は '%2$@' に接続されています。切断して、代わりにこの仮想マシンに接続しますか?"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' disambungake menyang '%2$@'. Apa sampeyan pengin medhot lan nyambung menyang mesin virtual iki?"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ დაკავშირებულია „%2$@“-თან. გსურთ მისი გათიშვა და ამ ვირტუალურ მანქანასთან დაკავშირება?"
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' құрылғысы '%2$@' машинасына қосылған. Оны ажыратып, орнына осы виртуалды машинаға қосқыңыз келе ме?"
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' ត្រូវបានភ្ជាប់ទៅ '%2$@'។ តើអ្នកចង់ផ្តាច់វា ហើយភ្ជាប់វាទៅម៉ាស៊ីននិម្មិតនេះជំនួសវិញទេ?"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' ಅನ್ನು '%2$@' ಗೆ ಸಂಪರ್ಕಿಸಲಾಗಿದೆ. ನೀವು ಅದರ ಸಂಪರ್ಕ ಕಡಿತಗೊಳಿಸಲು ಮತ್ತು ಬದಲಿಗೆ ಈ ವರ್ಚುವಲ್ ಯಂತ್ರಕ್ಕೆ ಸಂಪರ್ಕಿಸಲು ಬಯಸುವಿರಾ?"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@'이(가) '%2$@'에 연결되었습니다. 연결을 끊고 대신 이 가상 머신에 연결하시겠습니까?"
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ ass mat „%2$@“ verbonnen. Wëllt Dir d'Verbindung trennen an en amplaz mat dëser virtueller Maschinn verbannen?"
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' ເຊື່ອມຕໍ່ກັບ '%2$@' ຢູ່. ທ່ານຕ້ອງການຕັດການເຊື່ອມຕໍ່ ແລະ ເຊື່ອມຕໍ່ມັນກັບເຄື່ອງສະເໝືອນນີ້ແທນບໍ?"
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ prijungtas prie „%2$@“. Ar norite jį atjungti ir vietoj to prijungti prie šios virtualiosios mašinos?"
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' ir savienots ar '%2$@'. Vai vēlaties to atvienot un savienot ar šo virtuālo mašīnu?"
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ е поврзан со „%2$@“. Дали сакате да го исклучите и да го поврзете со оваа виртуелна машина?"
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' शी जोडलेले आहे. तुम्ही ते डिस्कनेक्ट करून त्याऐवजी या व्हर्च्युअल मशीनशी कनेक्ट करू इच्छिता?"
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' disambungkan ke '%2$@'. Adakah anda mahu memutuskan sambungannya dan menyambungkannya ke mesin maya ini?"
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' huwa konness ma' '%2$@'. Trid tiskonnettjah u tqabbdu ma' din il-magna virtwali minflok?"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' သည် '%2$@' နှင့် ချိတ်ဆက်ထားသည်။ ၎င်းကို ချိတ်ဆက်မှုဖြုတ်ပြီး ဤဗာချွယ်စက်နှင့် ချိတ်ဆက်လိုပါသလား။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' er koblet til '%2$@'. Vil du koble den fra og koble den til denne virtuelle maskinen i stedet?"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' मा जडान भएको छ। के तपाईं यसलाई विच्छेद गरेर यो भर्चुअल मेसिनमा जडान गर्न चाहनुहुन्छ?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' is verbonden met '%2$@'. Wilt u de verbinding verbreken en in plaats daarvan verbinden met deze virtuele machine?"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' ସହିତ କନେକ୍ଟ୍ ହୋଇଛି। ଏହାକୁ ଡିସ୍‌କନେକ୍ଟ୍ କରି ଏହା ବଦଳରେ ଏହି ଭର୍ଚୁଆଲ୍ ମେସିନ୍ ସହିତ କନେକ୍ଟ୍ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Urządzenie „%1$@” jest podłączone do „%2$@”. Czy chcesz je odłączyć i zamiast tego podłączyć do tej maszyny wirtualnej?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' está conectado a '%2$@'. Deseja desconectá-lo e conectá-lo a esta máquina virtual?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@” este conectat la „%2$@”. Doriți să îl deconectați și să îl conectați la această mașină virtuală?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» подключен к «%2$@». Вы хотите отключить его и вместо этого подключить к этой виртуальной машине?"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' سان ڳنڍيل آهي. ڇا توھان ان کي ڊسڪنيڪٽ ڪرڻ چاھيو ٿا ۽ ان جي بدران ھن ورچوئل مشين سان ڳنڍڻ چاھيو ٿا؟"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' වෙත සම්බන්ධ වී ඇත. ඔබට එය විසන්ධි කර ඒ වෙනුවට මෙම අතථ්‍ය යන්ත්‍රයට සම්බන්ධ කිරීමට අවශ්‍යද?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' je pripojený k '%2$@'. Chcete ho odpojiť a pripojiť namiesto toho k tomuto virtuálnemu počítaču?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "»%1$@« je povezan z »%2$@«. Ali ga želite odklopiti in ga namesto tega povezati s tem navideznim računalnikom?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\" është lidhur me \"%2$@\". Dëshironi ta shkëputni dhe ta lidhni me këtë makinë virtuale në vend të saj?"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%1$@“ је повезан са „%2$@“. Да ли желите да га искључите и повежете са овом виртуелном машином уместо тога?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' är kopplad till '%2$@'. Vill du koppla bort den och ansluta den till den här virtuella maskinen istället?"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' imeunganishwa kwa '%2$@'. Je, ungependa kuitenganisha nayo na kuiunganisha kwa mashine pepe hii badala yake?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' உடன் இணைக்கப்பட்டுள்ளது. அதைத் துண்டித்துவிட்டு, அதற்குப் பதிலாக இந்த மெய்நிகர் இயந்திரத்துடன் இணைக்க விரும்புகிறீர்களா?"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@'కి కనెక్ట్ చేయబడింది. మీరు దీన్ని డిస్‌కనెక్ట్ చేసి, బదులుగా ఈ వర్చువల్ మెషీన్‌కి కనెక్ట్ చేయాలనుకుంటున్నారా?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' เชื่อมต่อกับ '%2$@' คุณต้องการยกเลิกการเชื่อมต่อและเชื่อมต่อกับเครื่องเสมือนนี้แทนหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' cihazı şu anda '%2$@' sanal makinesine bağlı. Bağlantısını kesip bunun yerine bu sanal makineye bağlamak istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«%1$@» підключено до «%2$@». Відключити його й підключити до цієї віртуальної машини?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' '%2$@' سے منسلک ہے۔ کیا آپ اسے منقطع کرکے اس کی بجائے اس ورچوئل مشین سے جوڑنا چاہتے ہیں؟"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@” qurilmasi “%2$@” virtual mashinasiga ulangan. Uni uzib, o'rniga shu virtual mashinaga ulamoqchimisiz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'%1$@' được kết nối với '%2$@'. Bạn có muốn ngắt kết nối nó và kết nối nó với máy ảo này không?"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已連接至「%2$@」。你要中斷連線並連接至此虛擬機嗎？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”已连接到“%2$@”。你要断开连接并将其连接到此虚拟机吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已連線到「%2$@」。您是否要中斷它的連線，改為連線到此虛擬機器？"
          }
        }
      }
    },
