          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMを終了し、すべての実行中の仮想マシンを停止します。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pungkasi UTM lan mandhegake kabeh VM sing mlaku."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "შეწყვიტეთ UTM-ის მუშაობა და გააჩერეთ ყველა გაშვებული ვირტუალური მანქანა."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM жұмысын аяқтап, жұмыс істеп тұрған барлық виртуалды машинаны тоқтатыңыз."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "បញ្ចប់ UTM និងបញ្ឈប់ VM ទាំងអស់ដែលកំពុងដំណើរការ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ಅನ್ನು ಕೊನೆಗೊಳಿಸಿ ಮತ್ತು ಚಾಲನೆಯಲ್ಲಿರುವ ಎಲ್ಲಾ VMಗಳನ್ನು ನಿಲ್ಲಿಸಿ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM을 종료하고 실행 중인 모든 가상 머신을 중지합니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM zoumaachen an all lafend VMs stoppen."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຢຸດ UTM ແລະຢຸດການແລ່ນ VM ທັງໝົດ."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Išeikite iš „UTM“ ir sustabdykite visas veikiančias VM."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pārtraukt UTM darbību un apturēt visas darbojošās virtuālās mašīnas."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Затвори го UTM и запри ги сите виртуелни машини што работат."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM बंद करा आणि सर्व चालू असलेले VM थांबवा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tamatkan UTM dan hentikan semua VM yang sedang berjalan."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ittermina UTM u waqqaf il-magni virtwali kollha li qed jaħdmu."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ကို ရပ်စဲပြီး လည်ပတ်နေသော ဗာချွယ်စက်အားလုံးကို ရပ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avslutt UTM og stopp alle kjørende VM-er."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
