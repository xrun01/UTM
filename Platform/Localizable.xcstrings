    "Only boot operating systems signed by Microsoft or a trusted vendor. Most major Linux distributions are supported." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selflaai slegs bedryfstelsels wat deur Microsoft of 'n betroubare verskaffer onderteken is. Die meeste groot Linux-verspreidings word ondersteun."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تمهيد أنظمة التشغيل الموقّعة من Microsoft أو من مورّد موثوق به فقط. معظم توزيعات Linux الرئيسية مدعومة."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কেৱল Microsoft বা এটা বিশ্বাসযোগ্য বিক্ৰেতাই স্বাক্ষৰিত অপাৰেটিং চিস্টেমসমূহ বুট কৰক। বেছিভাগ প্ৰধান Linux বিতৰণ সমৰ্থিত।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnız Microsoft və ya etibarlı istehsalçı tərəfindən imzalanmış əməliyyat sistemlərini yükləyin. Əsas Linux distributivlərinin əksəriyyəti dəstəklənir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружайце толькі аперацыйныя сістэмы, падпісаныя Microsoft або надзейным пастаўшчыком. Падтрымліваюцца большасць асноўных дыстрыбутываў Linux."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зареждат се само операционни системи, подписани от Microsoft или доверен доставчик. Поддържат се повечето основни дистрибуции на Linux."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "শুধুমাত্র Microsoft বা কোনো বিশ্বস্ত ভেন্ডরের স্বাক্ষর করা অপারেটিং সিস্টেম বুট করুন। বেশিরভাগ প্রধান Linux ডিস্ট্রিবিউশন সমর্থিত।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokreće samo operativne sisteme koje je potpisao Microsoft ili pouzdani dobavljač. Podržana je većina velikih Linux distribucija."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Només arrenca sistemes operatius signats per Microsoft o per un proveïdor de confiança. S'admeten la majoria de les distribucions Linux principals."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mag-boot lamang sa mga operating system nga gipirmahan sa Microsoft o sa usa ka kasaligan nga vendor. Gisuportahan ang kadaghanan sa dagkong mga distribusyon sa Linux."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spouští pouze operační systémy podepsané společností Microsoft nebo důvěryhodným dodavatelem. Podporována je většina hlavních distribucí Linuxu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cychwyn systemau gweithredu sydd wedi'u llofnodi gan Microsoft neu werthwr dibynadwy yn unig. Cefnogir y rhan fwyaf o'r prif ddosbarthiadau Linux."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start kun operativsystemer, der er signeret af Microsoft eller en betroet leverandør. De fleste større Linux-distributioner understøttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet nur Betriebssysteme, die von Microsoft oder einem vertrauenswürdigen Anbieter signiert sind. Die meisten großen Linux-Distributionen werden unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Εκκινούνται μόνο λειτουργικά συστήματα που έχουν υπογραφεί από τη Microsoft ή από αξιόπιστο προμηθευτή. Υποστηρίζονται οι περισσότερες μεγάλες διανομές Linux."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrancar únicamente sistemas operativos firmados por Microsoft o por un proveedor de confianza. Se admite la mayoría de las distribuciones principales de Linux."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käivitatakse ainult Microsofti või usaldusväärse tarnija allkirjastatud operatsioonisüsteemid. Enamik suuremaid Linuxi distributsioone on toetatud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft-ek edo saltzaile fidagarri batek sinatutako sistema eragileak soilik abiarazi. Linux banaketa nagusi gehienak onartzen dira."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط سیستم‌عامل‌هایی بوت می‌شوند که Microsoft یا یک فروشنده مورد اعتماد آن‌ها را امضا کرده باشد. بیشتر توزیع‌های اصلی Linux پشتیبانی می‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käynnistä vain Microsoftin tai luotettavan toimittajan allekirjoittamat käyttöjärjestelmät. Suurin osa tärkeimmistä Linux-jakeluista on tuettu."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I-boot lang ang mga operating system na nilagdaan ng Microsoft o ng isang pinagkakatiwalaang vendor. Suportado ang karamihan sa mga pangunahing Linux distribution."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seuls les systèmes d'exploitation signés par Microsoft ou par un fournisseur de confiance peuvent démarrer. La plupart des principales distributions Linux sont prises en charge."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrancar só sistemas operativos asinados por Microsoft ou por un provedor de confianza. A maioría das principais distribucións de Linux son compatibles."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ફક્ત Microsoft અથવા વિશ્વસનીય વિક્રેતા દ્વારા સાઇન કરેલી ઓપરેટિંગ સિસ્ટમ જ બૂટ થશે. મોટાભાગના મુખ્ય Linux ડિસ્ટ્રિબ્યુશન સમર્થિત છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתחול רק של מערכות הפעלה שנחתמו על ידי Microsoft או על ידי ספק מהימן. רוב הפצות Linux הגדולות נתמכות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "केवल Microsoft या किसी विश्वसनीय वेंडर द्वारा साइन किए गए ऑपरेटिंग सिस्टम बूट होंगे। अधिकांश प्रमुख Linux डिस्ट्रीब्यूशन समर्थित हैं।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokreću se samo operacijski sustavi koje je potpisao Microsoft ili pouzdani dobavljač. Podržana je većina glavnih distribucija Linuxa."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a Microsoft vagy egy megbízható gyártó által aláírt operációs rendszerek indulhatnak el. A legtöbb nagyobb Linux-disztribúció támogatott."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Բեռնվում են միայն Microsoft-ի կամ վստահելի մատակարարի ստորագրած օպերացիոն համակարգերը։ Աջակցվում են Linux-ի հիմնական բաշխումների մեծ մասը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya boot sistem operasi yang ditandatangani oleh Microsoft atau vendor tepercaya. Sebagian besar distribusi Linux utama didukung."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ræsa aðeins stýrikerfi sem eru undirrituð af Microsoft eða traustum framleiðanda. Flestar helstu Linux-dreifingar eru studdar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avvia solo i sistemi operativi firmati da Microsoft o da un fornitore affidabile. Sono supportate la maggior parte delle principali distribuzioni Linux."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft または信頼できるベンダーが署名したオペレーティングシステムだけを起動します。主要な Linux ディストリビューションのほとんどに対応しています。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mung boot sistem operasi sing ditandatangani dening Microsoft utawa vendor sing dipercaya. Umume distribusi Linux utama didhukung."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ჩაიტვირთება მხოლოდ Microsoft-ის ან სანდო მომწოდებლის მიერ ხელმოწერილი ოპერაციული სისტემები. Linux-ის ძირითადი დისტრიბუციების უმეტესობა მხარდაჭერილია."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тек Microsoft немесе сенімді жеткізуші қол қойған операциялық жүйелерді жүктеңіз. Негізгі Linux дистрибутивтерінің көпшілігіне қолдау көрсетіледі."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ចាប់ផ្ដើមតែប្រព័ន្ធប្រតិបត្តិការដែលបានចុះហត្ថលេខាដោយ Microsoft ឬអ្នកផ្គត់ផ្គង់ដែលគួរឱ្យទុកចិត្តប៉ុណ្ណោះ។ គាំទ្រការចែកចាយ Linux សំខាន់ៗភាគច្រើន។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft ಅಥವಾ ವಿಶ್ವಾಸಾರ್ಹ ಮಾರಾಟಗಾರರು ಸೈನ್ ಮಾಡಿದ ಆಪರೇಟಿಂಗ್ ಸಿಸ್ಟಮ್‌ಗಳನ್ನು ಮಾತ್ರ ಬೂಟ್ ಮಾಡುತ್ತದೆ. ಹೆಚ್ಚಿನ ಪ್ರಮುಖ Linux ವಿತರಣೆಗಳು ಬೆಂಬಲಿತವಾಗಿವೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft 또는 신뢰할 수 있는 공급업체가 서명한 운영 체제만 부팅합니다. 대부분의 주요 Linux 배포판이 지원됩니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nëmme Betribssystemer booten, déi vu Microsoft oder engem vertrauenswierdege Fabrikant signéiert sinn. Déi meescht grouss Linux-Distributioune ginn ënnerstëtzt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບູດສະເພາະລະບົບປະຕິບັດການທີ່ລົງນາມໂດຍ Microsoft ຫຼື ຜູ້ຈຳໜ່າຍທີ່ເຊື່ອຖືໄດ້. ຮອງຮັບລຸ້ນແຈກຢາຍ Linux ຫຼັກໆສ່ວນໃຫຍ່."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paleidžiamos tik „Microsoft“ arba patikimo tiekėjo pasirašytos operacinės sistemos. Palaikoma dauguma pagrindinių „Linux“ platinimų."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sāknēt tikai operētājsistēmas, ko parakstījis Microsoft vai uzticams piegādātājs. Tiek atbalstīta lielākā daļa populārāko Linux izplatījumu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подигај само оперативни системи потпишани од Microsoft или од доверлив производител. Поддржани се повеќето поголеми дистрибуции на Linux."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "फक्त Microsoft किंवा विश्वसनीय विक्रेत्याने साइन केलेल्या ऑपरेटिंग सिस्टीम बूट होतील. बहुतेक प्रमुख Linux डिस्ट्रिब्यूशन समर्थित आहेत."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hanya but sistem pengendalian yang ditandatangani oleh Microsoft atau vendor yang dipercayai. Kebanyakan pengedaran Linux utama disokong."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ibbutja biss sistemi operattivi ffirmati minn Microsoft jew minn bejjiegħ fdat. Il-biċċa l-kbira tad-distribuzzjonijiet ewlenin tal-Linux huma appoġġjati."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft သို့မဟုတ် ယုံကြည်ရသော ရောင်းချသူက လက်မှတ်ထိုးထားသော လည်ပတ်မှုစနစ်များဖြင့်သာ စက်ဖွင့်သည်။ အဓိက Linux ဖြန့်ချိမှု အများစုကို ပံ့ပိုးသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start kun operativsystemer signert av Microsoft eller en pålitelig leverandør. De fleste større Linux-distribusjoner støttes."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft वा विश्वसनीय विक्रेताले हस्ताक्षर गरेका अपरेटिङ सिस्टम मात्र बुट हुन्छन्। धेरैजसो प्रमुख Linux वितरणहरू समर्थित छन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Start alleen besturingssystemen op die zijn ondertekend door Microsoft of een vertrouwde leverancier. De meeste grote Linux-distributies worden ondersteund."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "କେବଳ Microsoft କିମ୍ବା ଏକ ବିଶ୍ୱସ୍ତ ଭେଣ୍ଡର୍ ସାଇନ୍ କରିଥିବା ଅପରେଟିଂ ସିଷ୍ଟମ୍ ବୁଟ୍ ହେବ। ଅଧିକାଂଶ ପ୍ରମୁଖ Linux ଡିଷ୍ଟ୍ରିବ୍ୟୁସନ୍ ସପୋର୍ଟ୍ କରାଯାଏ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uruchamiaj tylko systemy operacyjne podpisane przez firmę Microsoft lub zaufanego dostawcę. Obsługiwana jest większość popularnych dystrybucji systemu Linux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicialize apenas sistemas operacionais assinados pela Microsoft ou por um fornecedor confiável. A maioria das principais distribuições Linux são suportadas."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pornește numai sistemele de operare semnate de Microsoft sau de un furnizor de încredere. Sunt acceptate majoritatea distribuțiilor Linux importante."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загружаются только операционные системы, подписанные Microsoft или доверенным поставщиком. Поддерживается большинство основных дистрибутивов Linux."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف Microsoft يا ڪنهن ڀروسي جوڳي وينڊر جا دستخط ٿيل آپريٽنگ سسٽم بوٽ ڪريو. اڪثر وڏيون Linux ڊسٽريبيوشنز سپورٽ ٿيل آهن."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft හෝ විශ්වාසනීය වෙළෙන්දෙකු විසින් අත්සන් කළ මෙහෙයුම් පද්ධති පමණක් අරඹයි. බොහෝ ප්‍රධාන Linux බෙදාහැරීම් සඳහා සහාය ඇත."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spúšťať iba operačné systémy podpísané spoločnosťou Microsoft alebo dôveryhodným dodávateľom. Podporuje sa väčšina hlavných distribúcií Linuxu."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaženejo se samo operacijski sistemi, ki jih je podpisal Microsoft ali zaupanja vreden prodajalec. Podprta je večina glavnih distribucij Linuxa."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nis vetëm sisteme operative të nënshkruara nga Microsoft ose nga një furnizues i besuar. Mbështeten shumica e shpërndarjeve kryesore të Linux."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Покрећу се само оперативни системи које је потписао Microsoft или поуздани произвођач. Подржана је већина главних Linux дистрибуција."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starta endast operativsystem som är signerade av Microsoft eller en betrodd leverantör. De flesta större Linux-distributioner stöds."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Washa mifumo endeshi iliyotiwa saini na Microsoft au muuzaji anayeaminika pekee. Mifumo mingi mikuu ya Linux inatumika."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft அல்லது நம்பகமான விற்பனையாளர் கையொப்பமிட்ட இயக்க முறைமைகளை மட்டுமே துவக்கும். பெரும்பாலான முக்கிய Linux விநியோகங்கள் ஆதரிக்கப்படுகின்றன."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microsoft లేదా విశ్వసనీయ విక్రేత సంతకం చేసిన ఆపరేటింగ్ సిస్టమ్‌లు మాత్రమే బూట్ అవుతాయి. చాలా ప్రధాన Linux డిస్ట్రిబ్యూషన్‌లకు మద్దతు ఉంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "บูตเฉพาะระบบปฏิบัติการที่ลงนามโดย Microsoft หรือผู้จำหน่ายที่เชื่อถือได้ รองรับ Linux ดิสทริบิวชันหลักส่วนใหญ่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yalnızca Microsoft veya güvenilir bir satıcı tarafından imzalanan işletim sistemlerini önyükleyin. Çoğu büyük Linux dağıtımı desteklenmektedir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Завантажуються лише операційні системи, підписані Microsoft або довіреним постачальником. Підтримується більшість основних дистрибутивів Linux."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صرف Microsoft یا کسی قابل اعتماد وینڈر کے دستخط شدہ آپریٹنگ سسٹم بوٹ ہوں گے۔ زیادہ تر بڑی Linux ڈسٹری بیوشنز تعاون یافتہ ہیں۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faqat Microsoft yoki ishonchli ishlab chiqaruvchi imzolagan operatsion tizimlarni yuklash. Ko'pchilik asosiy Linux distributivlari qo'llab-quvvatlanadi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chỉ khởi động hệ điều hành được ký bởi Microsoft hoặc nhà cung cấp đáng tin cậy. Hầu hết các bản phân phối Linux chính đều được hỗ trợ."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅啟動由 Microsoft 或可信任供應商簽署的作業系統。支援大多數主要 Linux 發行版。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅启动由 Microsoft 或可信供应商签名的操作系统。支持大多数主要 Linux 发行版。"
