    "When cloning a VM, regenerate MAC addresses on every network interface to prevent conflicts." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wanneer 'n VM gekloon word, hergenereer MAC-adresse op elke netwerkkoppelvlak om konflikte te voorkom."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عند استنساخ آلة افتراضية، تتم إعادة إنشاء عناوين MAC لكل واجهة شبكة لمنع التعارضات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM ক্ল'ন কৰোঁতে সংঘাত এৰাবলৈ প্ৰতিটো নেটৱৰ্ক ইণ্টাৰফেচৰ MAC ঠিকনা পুনৰ সৃষ্টি কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM-i klonlayanda ziddiyyətlərin qarşısını almaq üçün hər bir şəbəkə interfeysində MAC ünvanlarını yenidən yaradın."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Пры кланаванні віртуальнай машыны генераваць новыя MAC-адрасы для кожнага сеткавага інтэрфейсу, каб пазбегнуць канфліктаў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когато клонирате виртуална машина, генерирайте отново MAC адресите на всеки мрежов интерфейс, за да предотвратите конфликти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি VM ক্লোন করার সময়, দ্বন্দ্ব প্রতিরোধ করতে প্রতিটি নেটওয়ার্ক ইন্টারফেসে MAC ঠিকানাগুলি পুনরায় তৈরি করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pri kloniranju virtuelne mašine ponovo generirajte MAC adrese na svakom mrežnom interfejsu kako biste spriječili sukobe."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En clonar una màquina virtual, regenera les adreces MAC de cada interfície de xarxa per evitar conflictes."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung nag-clone sa usa ka VM, i-regenerate ang mga MAC address sa matag interface sa network aron malikayan ang mga panagbangi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Při klonování virtuálního počítače znovu vygeneruje adresy MAC všech síťových rozhraní, aby nedošlo ke konfliktům."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wrth glonio VM, ail-grëwch gyfeiriadau MAC ar bob rhyngwyneb rhwydwaith i atal gwrthdaro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generer nye MAC-adresser på alle netværksgrænseflader ved kloning af en VM for at undgå konflikter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beim Klonen einer VM werden die MAC-Adressen aller Netzwerkschnittstellen neu generiert, um Konflikte zu vermeiden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Κατά την κλωνοποίηση μιας εικονικής μηχανής, δημιουργούνται νέες διευθύνσεις MAC σε κάθε διεπαφή δικτύου για την αποφυγή διενέξεων."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al clonar una VM, se regeneran las direcciones MAC de cada interfaz de red para evitar conflictos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM-i kloonimisel genereeritakse konfliktide vältimiseks kõigi võrguliideste MAC-aadressid uuesti."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makina birtual bat klonatzean, birsortu MAC helbideak sareko interfaze guztietan, gatazkak saihesteko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هنگام کلون کردن ماشین مجازی، آدرس‌های MAC همه رابط‌های شبکه دوباره تولید می‌شوند تا از تداخل جلوگیری شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Luo MAC-osoitteet uudelleen jokaiselle verkkoliitännälle virtuaalikonetta kloonattaessa, jotta vältetään ristiriidat."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kapag nag-clone ng VM, muling buuin ang mga MAC address sa bawat interface ng network upang maiwasan ang mga salungatan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors du clonage d'une VM, régénérez les adresses MAC sur chaque interface réseau pour éviter les conflits."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao clonar unha máquina virtual, rexenera os enderezos MAC en cada interface de rede para evitar conflitos."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM ક્લોન કરતી વખતે, ટકરાવ ટાળવા માટે દરેક નેટવર્ક ઇન્ટરફેસ પર MAC સરનામાં ફરીથી બનાવો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בעת שכפול VM, צור מחדש כתובות MAC בכל ממשק רשת כדי למנוע התנגשויות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM क्लोन करते समय, टकराव से बचने के लिए हर नेटवर्क इंटरफ़ेस के MAC पते फिर से बनाएँ।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prilikom kloniranja VM-a, ponovno generirajte MAC adrese na svakom mrežnom sučelju kako biste spriječili sukobe."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
