        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如要更改此選項，請移除分享的目錄並重新加回。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要更改此选项，请移除共享目录并重新添加。"
