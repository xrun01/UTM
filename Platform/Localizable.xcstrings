        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "منتخب کریں کہ آیا UTM ورچوئل مشینوں کو چلانے کی حالت کو بچاتا ہے یا درخواست کرتا ہے کہ UTM چھوڑنے پر ان کے مہمان آپریٹنگ سسٹم بند ہو جائیں۔"
