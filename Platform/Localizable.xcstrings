    },
    "Tells the VM process to shut down with risk of data corruption. This simulates holding down the power button on a PC." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sê vir die VM-proses om af te skakel, met 'n risiko van datakorrupsie. Dit simuleer om die aan/uit-knoppie van 'n rekenaar ingedruk te hou."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخبر عملية الآلة الافتراضية بإيقاف التشغيل مع خطر تلف البيانات. هذا يحاكي الضغط مع الاستمرار على زر الطاقة في الكمبيوتر الشخصي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM ৰ প্ৰক্ৰিয়াক বন্ধ হ'বলৈ কয়, ইয়াত তথ্য নষ্ট হোৱাৰ আশংকা আছে। ই PC ৰ পাৱাৰ বুটাম টিপি ধৰি ৰখাৰ দৰে কাম কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM prosesinə söndürülmə əmri verir, məlumatların korlanması riski var. Bu, PC-də qidalanma düyməsini basıb saxlamağı simulyasiya edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Загадвае працэсу віртуальнай машыны спыніцца з рызыкай пашкоджання даных. Гэта імітуе ўтрыманне кнопкі сілкавання на ПК."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Указва на процеса на виртуалната машина да се изключи с риск от повреда на данните. Това симулира задържане на бутона за захранване на компютър."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM প্রসেসকে শাট ডাউন করতে বলে, এতে ডেটা নষ্ট হওয়ার ঝুঁকি আছে। এটি পিসিতে পাওয়ার বোতাম চেপে ধরে রাখার অনুকরণ করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaže procesu virtuelne mašine da se isključi, uz rizik od oštećenja podataka. Ovo simulira držanje pritisnutog dugmeta za napajanje na PC računaru."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica al procés de la màquina virtual que s'apagui, amb risc de malmetre les dades. Això simula mantenir premut el botó d'engegada d'un ordinador."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gisultihan ang proseso sa VM nga mopalong, nga adunay peligro sa korapsyon sa datos. Kini nagsundog sa dugay nga pagpindot sa power button sa usa ka PC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Řekne procesu virtuálního počítače, aby se vypnul s rizikem poškození dat. To simuluje podržení tlačítka napájení na PC."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yn dweud wrth y broses VM i gau i lawr gyda risg o lygredd data. Mae hyn yn efelychu dal y botwm pŵer i lawr ar gyfrifiadur personol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beder VM-processen om at lukke ned med risiko for datakorruption. Dette simulerer at holde tænd/sluk-knappen nede på en pc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weist den VM-Prozess an, sich zu beenden. Dabei besteht das Risiko einer Datenbeschädigung. Dies simuliert das Gedrückthalten des Netzschalters an einem PC."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δίνει εντολή στη διεργασία της εικονικής μηχανής να τερματιστεί, με κίνδυνο καταστροφής δεδομένων. Αυτό προσομοιώνει το παρατεταμένο πάτημα του κουμπιού λειτουργίας σε έναν υπολογιστή."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica al proceso de la VM que se apague, con riesgo de corromper los datos. Esto simula mantener presionado el botón de apagado en una PC."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käsib VM-i protsessil välja lülituda, andmete riknemise oht on olemas. See simuleerib arvuti toitenupu all hoidmist."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Makina birtualaren prozesuari itzaltzeko esaten dio, datuak hondatzeko arriskuarekin. Ordenagailu bateko pizte-botoia sakatuta edukitzea simulatzen du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "به فرایند ماشین مجازی دستور خاموش شدن می‌دهد که خطر خرابی داده‌ها را دارد. این کار مانند نگه داشتن دکمه پاور در رایانه شخصی است."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käskee virtuaalikoneen prosessia sammumaan, jolloin tiedot voivat vioittua. Tämä simuloi tietokoneen virtapainikkeen pitämistä painettuna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinasabihan ang proseso ng VM na mag-shut down, na may panganib na masira ang data. Ginagaya nito ang matagal na pagpindot sa power button ng isang PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique au processus de la VM de s’arrêter avec un risque de corruption des données. Cela simule un appui prolongé sur le bouton d’alimentation du PC."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dille ao proceso da máquina virtual que se apague con risco de corrupción dos datos. Isto simula manter premido o botón de acendido nun PC."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM પ્રક્રિયાને શટ ડાઉન થવાનું કહે છે, જેમાં ડેટા બગડવાનું જોખમ છે. આ PC પર પાવર બટન દબાવી રાખવાનું અનુકરણ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "מורה לתהליך ה-VM לכבות, בסיכון להשחתת נתונים. זה מדמה לחיצה ממושכת על לחצן ההפעלה במחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM प्रोसेस को शट डाउन करने के लिए कहता है, जिसमें डेटा खराब होने का जोखिम है। यह PC पर पावर बटन दबाए रखने का अनुकरण करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nalaže procesu VM-a da se isključi uz rizik od oštećenja podataka. To simulira držanje tipke za uključivanje na PC-ju."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utasítja a virtuálisgép-folyamatot, hogy álljon le, ami adatsérülést okozhat. Ez a számítógép bekapcsológombjának lenyomva tartását szimulálja."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Հրահանգում է վիրտուալ մեքենայի գործընթացին անջատվել՝ տվյալների վնասման ռիսկով։ Սա նմանակում է համակարգչի սնուցման կոճակը սեղմած պահելը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Memberitahukan proses VM untuk dimatikan dengan risiko kerusakan data. Ini mensimulasikan menahan tombol daya pada PC."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segir ferli sýndarvélarinnar að slökkva á sér, með hættu á að gögn skemmist. Þetta líkir eftir því að aflhnappinum á PC-tölvu sé haldið niðri."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa il processo della VM di arrestarsi con il rischio di compromettere dei dati. Questo simula la pressione prolungata del tasto di accensione di un PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのプロセスにデータ破損のリスクを伴うシステム終了を指示します。これにより、PCの電源ボタン長押しをシミュレートします。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ngandhani proses VM supaya mati, kanthi risiko data rusak. Iki padha karo menet terus tombol daya ing PC."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ვირტუალური მანქანის პროცესს უბრძანებს გამორთვას, რაც მონაცემების დაზიანების რისკს შეიცავს. ეს ახდენს კომპიუტერზე დენის ღილაკის ხანგრძლივად დაჭერის სიმულაციას."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виртуалды машина процесіне өшуді бұйырады, деректердің бүліну қаупі бар. Бұл компьютердегі қуат түймесін басып ұстап тұруға ұқсайды."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ប្រាប់ដំណើរការរបស់ VM ឱ្យបិទ ដោយមានហានិភ័យធ្វើឱ្យទិន្នន័យខូច។ វាធ្វើដូចជាការសង្កត់ប៊ូតុងថាមពលឱ្យជាប់នៅលើកុំព្យូទ័រ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಡೇಟಾ ಹಾಳಾಗುವ ಅಪಾಯದೊಂದಿಗೆ VM ಪ್ರಕ್ರಿಯೆಗೆ ಶಟ್ ಡೌನ್ ಆಗಲು ಹೇಳುತ್ತದೆ. ಇದು PCಯಲ್ಲಿ ಪವರ್ ಬಟನ್ ಅನ್ನು ಒತ್ತಿ ಹಿಡಿಯುವುದನ್ನು ಅನುಕರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 머신 프로세스에 종료 신호를 보냅니다. 데이터가 손상될 위험이 있습니다. 이는 PC의 전원 버튼을 길게 누르는 행동을 흉내냅니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seet dem VM-Prozess, sech auszeschalten, mam Risiko, datt Date beschiedegt ginn. Dat simuléiert, datt den Un/Aus-Knäppchen vun engem PC gedréckt gehale gëtt."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ບອກໃຫ້ຂະບວນການ VM ປິດລົງ ເຊິ່ງມີຄວາມສ່ຽງທີ່ຂໍ້ມູນຈະເສຍຫາຍ. ການດຳເນີນການນີ້ຈຳລອງການກົດປຸ່ມເປີດປິດຂອງ PC ຄ້າງໄວ້."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nurodo VM procesui išsijungti, rizikuojant sugadinti duomenis. Tai imituoja kompiuterio maitinimo mygtuko nuspaudimą ir laikymą."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liek virtuālās mašīnas procesam izslēgties, radot datu sabojāšanas risku. Tas imitē datora barošanas pogas turēšanu nospiestu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Му наложува на процесот на виртуелната машина да се исклучи, со ризик од оштетување на податоците. Ова симулира држење на копчето за напојување на компјутер."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डेटा करप्शनच्या जोखमीसह VM प्रक्रियेला शट डाउन होण्यास सांगते. हे PC वरील पॉवर बटण दाबून ठेवण्यासारखे आहे."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mengarahkan proses VM supaya dimatikan dengan risiko kerosakan data. Ini menyerupai tindakan menahan butang kuasa pada PC."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jgħid lill-proċess tal-magna virtwali biex jintefa, b'riskju ta' korruzzjoni tad-data. Dan jissimula ż-żamma tal-buttuna tal-enerġija fuq PC."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဒေတာ ပျက်စီးနိုင်ခြေ ရှိသော်လည်း ဗာချွယ်စက် လုပ်ငန်းစဉ်ကို ပိတ်ရန် ညွှန်ကြားသည်။ ၎င်းသည် PC ၏ ပါဝါခလုတ်ကို ဖိထားခြင်းနှင့် တူသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvinger VM-prosessen til å slå seg av, med risiko for skadede data. Dette simulerer å holde nede strømknappen på en PC."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "डाटा बिग्रने जोखिमसहित VM प्रक्रियालाई बन्द हुन भन्छ। यसले PC को पावर बटन थिचिराखेको जस्तो गर्छ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draagt het VM-proces op om uit te schakelen, met risico op gegevensbeschadiging. Dit simuleert het ingedrukt houden van de aan/uit-knop op een pc."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଡାଟା କ୍ଷତିଗ୍ରସ୍ତ ହେବାର ଆଶଙ୍କା ସହିତ VM ପ୍ରୋସେସ୍‌କୁ ସଟ୍ ଡାଉନ୍ କରିବାକୁ କହେ। ଏହା PC ରେ ପାୱାର୍ ବଟନ୍ ଦବାଇ ଧରି ରଖିବା ପରି କାମ କରେ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakazuje procesowi maszyny wirtualnej wyłączenie z ryzykiem uszkodzenia danych. Symuluje to przytrzymanie przycisku zasilania w komputerze PC."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa ao processo da VM que ele deve desligar, com risco de corrupção de dados. Isso simula manter pressionado o botão liga/desliga de um PC."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cere procesului mașinii virtuale să se oprească, cu risc de corupere a datelor. Aceasta simulează menținerea apăsată a butonului de alimentare al unui PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дает процессу ВМ команду на выключение с риском повреждения данных. Это имитирует удержание кнопки питания на ПК."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM جي پروسيس کي بند ٿيڻ جو چوي ٿو، ڊيٽا خراب ٿيڻ جو خطرو آهي. هي PC تي پاور بٽڻ دٻائي رکڻ جهڙو آهي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "දත්ත දූෂණය වීමේ අවදානම සමඟ වසා දැමීමට VM ක්‍රියාවලියට කියයි. මෙය පරිගණකයක බල බොත්තම තද කරගෙන සිටීම අනුකරණය කරයි."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prikáže procesu virtuálneho počítača vypnúť sa s rizikom poškodenia údajov. Simuluje to podržanie vypínača na PC."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Procesu navideznega računalnika sporoči, naj se zaustavi, pri čemer obstaja tveganje poškodbe podatkov. To simulira držanje gumba za vklop na osebnem računalniku."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I thotë procesit të VM-së të fiket, me rrezik dëmtimi të të dhënave. Kjo simulon mbajtjen shtypur të butonit të energjisë në një PC."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Налаже процесу виртуелне машине да се искључи уз ризик од оштећења података. Ово симулира држање дугмета за напајање на рачунару."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uppmanar processen för den virtuella maskinen att stängas av, med risk för datakorruption. Detta simulerar att strömknappen hålls nedtryckt på en PC."
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inaambia mchakato wa mashine pepe uzime, kwa hatari ya uharibifu wa data. Hii inaiga kushikilia kitufe cha kuwasha/kuzima kwenye Kompyuta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "தரவு சிதைவு அபாயத்துடன் VM செயல்முறையை ஷட் டவுன் செய்யச் சொல்கிறது. இது கணினியில் பவர் பட்டனை அழுத்தி வைத்திருப்பதை உருவகப்படுத்துகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM ప్రాసెస్‌ను షట్ డౌన్ కావాలని చెబుతుంది, ఇందులో డేటా పాడయ్యే ప్రమాదం ఉంది. ఇది PCలో పవర్ బటన్‌ను నొక్కి పట్టుకోవడాన్ని అనుకరిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แจ้งให้กระบวนการ VM ปิดตัวลงโดยมีความเสี่ยงที่ข้อมูลจะเสียหาย นี่เป็นการจำลองการกดปุ่มเปิดปิดบนพีซีค้างไว้"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM sürecine kapanmasını söyler; veri bozulması riski vardır. Bu, bir PC'deki güç düğmesini basılı tutmaya benzer."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Наказує процесу віртуальної машини завершити роботу, що може пошкодити дані. Це імітує утримання кнопки живлення на ПК."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM کے پروسیس کو بند ہونے کا کہتا ہے، جس سے ڈیٹا خراب ہونے کا خطرہ ہے۔ یہ پی سی کا پاور بٹن دبائے رکھنے کی نقل کرتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM jarayoniga o'chishni buyuradi, bunda ma'lumotlar buzilishi xavfi bor. Bu kompyuterda quvvat tugmasini bosib turishni taqlid qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yêu cầu tiến trình máy ảo tắt, có nguy cơ hỏng dữ liệu. Thao tác này mô phỏng việc nhấn giữ nút nguồn trên PC."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓虛擬機程序關機，會有風險損毀資料。此操作模擬了在 PC 上長按電源按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知虚拟机进程关闭 (存在数据损坏的风险)。这一操作模拟了按住 PC 上的电源按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴虛擬機器程序關機，可能導致資料損壞。模擬長按 PC 的關機鍵。"
          }
        }
      }
    },
