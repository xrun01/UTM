        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inatuma ombi la kuzima kwa mgeni. Hii inaiga kubonyeza kitufe cha kuwasha/kuzima kwenye Kompyuta."
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "விருந்தினருக்கு பவர் டவுன் கோரிக்கையை அனுப்புகிறது. இது கணினியில் பவர் பட்டனை அழுத்துவதை உருவகப்படுத்துகிறது."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "గెస్ట్‌కు పవర్ డౌన్ అభ్యర్థనను పంపుతుంది. ఇది PCలో పవర్ బటన్‌ను నొక్కడాన్ని అనుకరిస్తుంది."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ส่งคำขอปิดเครื่องไปยังเกสต์ นี่เป็นการจำลองการกดปุ่มเปิดปิดบนพีซี"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konuğa güç kapatma isteği gönderir. Bu, bir PC'deki güç düğmesine basmayı simüle eder."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Надсилає гостьовій системі запит на вимкнення. Це імітує натискання кнопки живлення на ПК."
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گیسٹ سسٹم کو بند ہونے کی درخواست بھیجتا ہے۔ یہ پی سی کا پاور بٹن دبانے کی نقل کرتا ہے۔"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehmonga quvvatni o'chirish so'rovini yuboradi. Bu kompyuterda quvvat tugmasini bosishni taqlid qiladi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gửi yêu cầu tắt nguồn đến khách. Thao tác này mô phỏng việc nhấn nút nguồn trên PC."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送關閉電源要求至客體。此操作模擬了按一下 PC 上的電源按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向客户机发送关闭电源请求。此操作模拟了按下 PC 上的电源按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將關機請求送往客體，模擬按下 PC 的關機鍵。"
          }
        }
      }
    },
