    "macOS guests are only supported on ARM64 devices." : {
      "comment" : "VMWizardOSMacView",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الضيوف من نظام macOS مدعومون فقط على أجهزة ARM64."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS VMs werden nur auf ARM64 Architektur unterstützt."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los clientes de macOS sólo están soportados en dispositivos ARM64."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les machines macOS invitées ne sont prises en charge que sur les apparareils en ARM64."
          }
        },
        "it" : {
          "stringUnit" : {
