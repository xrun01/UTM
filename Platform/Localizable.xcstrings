        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ar norite perkelti šią VM į kitą vietą? Tai nukopijuos duomenis į naują vietą, ištrins duomenis iš pradinės vietos ir sukurs nuorodą."
