        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "स्न्यापसट '%@' पुनर्स्थापना गर्न सकिँदैन किनभने यसले भर्चुअल मेसिनका सबै ड्राइभ समेट्दैन, जस्तै स्न्यापसट लिइसकेपछि थपिएको ड्राइभ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De snapshot '%@' kan niet worden hersteld omdat deze niet alle schijven van de virtuele machine omvat, zoals een schijf die is toegevoegd nadat de snapshot is gemaakt."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ସ୍ନାପସଟ୍ '%@' ରିଷ୍ଟୋର୍ କରିହେବ ନାହିଁ, କାରଣ ଏଥିରେ ଭର୍ଚୁଆଲ୍ ମେସିନ୍‌ର ସମସ୍ତ ଡ୍ରାଇଭ୍ ଅନ୍ତର୍ଭୁକ୍ତ ନାହିଁ, ଯେପରି ସ୍ନାପସଟ୍ ନେବା ପରେ ଯୋଗ କରାଯାଇଥିବା ଡ୍ରାଇଭ୍।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie można przywrócić migawki „%@”, ponieważ nie obejmuje ona wszystkich dysków maszyny wirtualnej, np. dysku dodanego po jej wykonaniu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instantâneo '%@' não pode ser restaurado porque não cobre todas as unidades da máquina virtual, por exemplo, uma unidade adicionada depois que ele foi criado."
