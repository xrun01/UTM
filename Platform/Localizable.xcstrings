        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای نصب macOS باید یک IPSW بازیابی دانلود کنید. اگر IPSW موجودی انتخاب نکنید، جدیدترین IPSW مربوط به macOS از Apple دانلود می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS:n asentamiseksi sinun on ladattava palautus-IPSW. Jos et valitse olemassa olevaa IPSW:tä, uusin macOS-IPSW ladataan Applelta."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para mag-install ng macOS, kailangan mong mag-download ng recovery IPSW. Kung hindi ka pipili ng umiiral na IPSW, ida-download mula sa Apple ang pinakabagong macOS IPSW."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour installer macOS, vous devez télécharger un IPSW de récupération. Si vous ne sélectionnez pas un IPSW existant, le dernier IPSW de macOS en date sera téléchargé depuis les serveurs d’Apple."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para instalar macOS, debes descargar un IPSW de recuperación. Se non seleccionas un IPSW existente, o último IPSW de macOS descargarase de Apple."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ઇન્સ્ટોલ કરવા માટે, તમારે પુનઃપ્રાપ્તિ IPSW ડાઉનલોડ કરવાની જરૂર છે. જો તમે હાલનું IPSW પસંદ ન કરો, તો નવીનતમ macOS IPSW Apple પરથી ડાઉનલોડ કરવામાં આવશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כדי להתקין את macOS, עליך להוריד IPSW לשחזור. אם לא תבחר IPSW קיים, ה-IPSW העדכני ביותר של macOS יורד מ-Apple."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS इंस्टॉल करने के लिए, आपको एक रिकवरी IPSW डाउनलोड करना होगा। अगर आप कोई मौजूदा IPSW नहीं चुनते, तो नवीनतम macOS IPSW Apple से डाउनलोड किया जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da biste instalirali macOS, trebate preuzeti IPSW za oporavak. Ako ne odaberete postojeći IPSW, najnoviji macOS IPSW bit će preuzet od Applea."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A macOS telepítéséhez le kell töltenie egy helyreállítási IPSW-t. Ha nem választ ki egy meglévő IPSW-t, a legújabb macOS IPSW letöltődik az Apple-től."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-ը տեղադրելու համար անհրաժեշտ է ներբեռնել վերականգնման IPSW։ Եթե առկա IPSW չընտրեք, Apple-ից կներբեռնվի macOS-ի վերջին IPSW-ն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Untuk menginstal macOS, Anda perlu mengunduh IPSW pemulihan. Jika Anda tidak memilih IPSW yang ada, IPSW macOS terbaru akan diunduh dari Apple."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Til að setja upp macOS þarftu að hlaða niður IPSW-endurheimtarskrá. Ef þú velur ekki fyrirliggjandi IPSW-skrá verður nýjustu macOS IPSW-skránni hlaðið niður frá Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per installare macOS, avrai bisogno di scaricare un file IPSW per il ripristino. Se non selezioni un file IPSW esistente, verrà scaricata da Apple l'ultima versione del file di ripristino IPSW di macOS."
