    "Choose whether UTM saves the state of running virtual machines or requests that their guest operating systems shut down when UTM quits." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies of UTM die toestand van lopende virtuele masjiene stoor of hul gasstelsels versoek om af te skakel wanneer jy UTM verlaat."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما إذا كان UTM يحفظ حالة الآلات الافتراضية قيد التشغيل أو يطلب من أنظمة الضيف فيها إيقاف التشغيل عند الخروج من UTM."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ৰ পৰা প্ৰস্থান কৰোঁতে UTM এ চলি থকা ভাৰ্চুৱেল মেচিনৰ অৱস্থা সংৰক্ষণ কৰিব নে সিহঁতৰ অতিথি চিস্টেম বন্ধ কৰিবলৈ অনুৰোধ কৰিব, সেয়া বাছনি কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM-dən çıxanda UTM-in işləyən virtual maşınların vəziyyətini yadda saxlayacağını, yoxsa onların qonaq əməliyyat sistemlərinin söndürülməsini tələb edəcəyini seçin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберыце, ці захоўвае UTM стан запушчаных віртуальных машын або запытвае выключэнне іх гасцявых аперацыйных сістэм пры выхадзе з UTM."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете дали при излизане от UTM да се запазва състоянието на работещите виртуални машини, или да се изпраща заявка за изключване на гостуващите им операционни системи."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
