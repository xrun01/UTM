    "Cannot find AltServer for JIT enable. You cannot run VMs until JIT is enabled." : {
      "comment" : "UTMData",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن العثور على AltServer لتمكين JIT. لا يمكنك تشغيل الآلات الافتراضية حتى يتم تمكين JIT."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der AltServer für JIT wurde nicht gefunden. Die VMs können nicht starten, bis JIT aktiviert wurde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra AltServer para habilitar JIT. No puedes ejecutar VMs hasta que JIT esté habilitado."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT:n käyttöönottoon tarvittavaa AltServeria ei löydy. Et voi suorittaa virtuaalikoneita, ennen kuin JIT on käytössä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de trouver AltServer pour activation JIT. Vous ne pouvez pas démarrer de VM tant que JIT n’est pas activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile trovare AltServer per l'abilitazione di JIT. Non è possibile eseguire macchine virtuali senza che JIT sia abilitato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JITを有効にするためのAltServerを見つけられません。JITが有効になるまで仮想マシンを実行できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT 활성화를 위한 AltServer를 찾을 수 없습니다. JIT가 활성화되기 전까지는 가상 머신을 실행할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się znaleźć AltServer do włączenia JIT. Uruchamianie maszyn wirtualnych nie będzie możliwe, dopóki JIT nie zostanie włączony."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удается найти AltServer для включения JIT. Запуск виртуальных машин невозможен до тех пор, пока не будет включена функция JIT."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到用於啟用 JIT 的 AltServer。在啟用 JIT 之前，你無法執行虛擬機。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到用于启用 JIT 的 AltServer。在启用 JIT 之前，你将无法运行虚拟机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到用來啟用 JIT 的 AltServer。啟用 JIT 後您才可以啟動虛擬機器。"
          }
        }
      }
    },
    "Cannot import this VM. Either the configuration is invalid, created in a newer version of UTM, or on a platform that is incompatible with this version of UTM." : {
      "comment" : "UTMData",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استيراد هذه الآلة الافتراضية. إما أن التكوين غير صالح، أو تم إنشاؤها في إصدار أحدث من UTM، أو على نظام أساسي غير متوافق مع هذا الإصدار من UTM."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die VM kann nicht importiert werden. Entweder ist die Konfiguration ungültig, oder sie wurde mit einer neueren Version von UTM oder auf einer Plattform erstellt, die mit dieser Version von UTM nicht kompatibel ist."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede importar esta VM. La configuración no es válida, se creó con una versión más reciente de UTM o en una plataforma incompatible con esta versión de UTM."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tätä virtuaalikonetta ei voi tuoda. Joko kokoonpano on virheellinen, se on luotu uudemmassa UTM-versiossa tai alustalla, joka ei ole yhteensopiva tämän UTM-version kanssa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’importer cette VM. Soit la configuration n’est pas valide, soit elle a été créée avec une version plus récente d’UTM ou sur une plateforme incompatible avec cette version d’UTM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile importare questa macchina virtuale. La configurazione non è valida, oppure è stata creata con una versione più recente di UTM o su una piattaforma non compatibile con questa versione di UTM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この仮想マシンは読み込めません。構成が無効であるか、新しいバージョンのUTM、またはこのバージョンのUTMと互換性のないプラットフォームで作成されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 가상 머신을 가져올 수 없습니다. 구성이 잘못되었거나, 상위 UTM 버전에서 생성되었거나, 이 UTM 버전과 호환되지 않는 플랫폼에서 생성되었을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zaimportować tej maszyny wirtualnej. Konfiguracja może nie być prawidłowa albo została utworzona w nowszej wersji UTM lub na platformie, która nie jest kompatybilna z tą wersją UTM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Невозможно импортировать данную ВМ. Либо конфигурация недействительна, либо создана в более новой версии UTM, либо на платформе, несовместимой с данной версией UTM."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法匯入此虛擬機。可能設定無效，或是在較新版本的 UTM 上製作，或是在與此版本的 UTM 不相容的平台上製作。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法导入此虚拟机。原因可能是配置无效、在较新版本的 UTM 中创建，或在与此版本 UTM 不兼容的平台上创建。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法匯入此虛擬機器。可能是組態無效、由較新版本的 UTM 建立，或是在與此版本 UTM 不相容的平台上建立。"
          }
        }
      }
    },
