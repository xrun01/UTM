    "Suspend state cannot be saved when running without saving changes." : {
      "comment" : "UTMAppleVirtualMachine",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن حفظ حالة التعليق عند التشغيل دون حفظ التغييرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Suspend-Status kann nicht gespeichert werden, wenn die Ausführung ausgeführt wird, ohne dass Änderungen gespeichert werden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "El estado de suspensión no se puede guardar cuando se ejecuta sin guardar los cambios."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Keskeytystilaa ei voi tallentaa suoritettaessa muutoksia tallentamatta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'état de suspension ne peut pas être enregistré lors de l'exécution sans enregistrer les modifications."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lo stato di sospensione non può essere salvato durante l'esecuzione senza salvare le modifiche."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "変更を保存せずに実行している場合、サスペンド状態は保存できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "변경 사항을 저장하지 않고 실행하는 경우 일시 중지 상태를 저장할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można zapisać stanu zawieszenia podczas działania bez zapisania zmian."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Состояние приостановки невозможно сохранить при работе без сохранения изменений."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不儲存變更的情況下執行時，無法儲存擱置狀態。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
