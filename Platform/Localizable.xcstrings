    "When cloning a VM, regenerate MAC addresses on every network interface to prevent conflicts." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wanneer 'n VM gekloon word, herstel MAC-adresse op elke netwerkkoppelvlak om konflikte te voorkom."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عند استنساخ جهاز افتراضي، قم بإعادة إنشاء عناوين MAC على كل واجهة شبكة لمنع التعارضات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটা VM ক্ল'ন কৰাৰ সময়ত, সংঘাত প্ৰতিৰোধ কৰিবলে প্ৰতিটো নে'টৱৰ্ক আন্তঃপৃষ্ঠত MAC ঠিকনাসমূহ পুনৰুত্পাদন কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM-ni klonlayarkən, münaqişələrin qarşısını almaq üçün hər bir şəbəkə interfeysində MAC ünvanlarını bərpa edin."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пры кланаванні віртуальнай машыны аднаўляйце MAC-адрасы на кожным сеткавым інтэрфейсе, каб прадухіліць канфлікты."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Когато клонирате VM, генерирайте отново MAC адресите на всеки мрежов интерфейс, за да предотвратите конфликти."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একটি VM ক্লোন করার সময়, দ্বন্দ্ব প্রতিরোধ করতে প্রতিটি নেটওয়ার্ক ইন্টারফেসে MAC ঠিকানাগুলি পুনরায় তৈরি করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kada klonirate VM, regenerirajte MAC adrese na svakom mrežnom sučelju kako biste spriječili sukobe."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quan cloneu una màquina virtual, regenera les adreces MAC a cada interfície de xarxa per evitar conflictes."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kung nag-clone sa usa ka VM, i-regenerate ang mga MAC address sa matag interface sa network aron malikayan ang mga panagbangi."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Při klonování virtuálního počítače obnovte MAC adresy na každém síťovém rozhraní, abyste předešli konfliktům."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wrth glonio VM, adfywiwch gyfeiriadau MAC ar bob rhyngwyneb rhwydwaith i atal gwrthdaro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Når du kloner en VM, skal du genskabe MAC-adresser på hver netværksgrænseflade for at forhindre konflikter."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Generieren Sie beim Klonen einer VM MAC-Adressen auf jeder Netzwerkschnittstelle neu, um Konflikte zu vermeiden."
          }
