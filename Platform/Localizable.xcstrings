        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "যদি সামৰ্থবান কৰা হয়, এটা সম্পূৰ্ণ পৰ্দা VM প্ৰদৰ্শনে বিল্ট-ইন কেমেৰাৰ কাষৰ অঞ্চল অন্তৰ্ভুক্ত কৰি সমগ্ৰ পৰ্দা ব্যৱহাৰ কৰিব। প্ৰকাশ পোৱাৰ সময়ত মেনু বাৰে এই অঞ্চলটো সামৰি ল’ব।"
