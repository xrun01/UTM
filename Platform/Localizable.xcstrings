        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żomm UTM jaħdem wara li tingħalaq l-aħħar tieqa u l-magni virtwali kollha jintfew"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "နောက်ဆုံးဝင်းဒိုးကို ပိတ်ပြီး ဗာချွယ်စက်အားလုံး စက်ပိတ်ပြီးနောက်တွင်လည်း UTM ကို ဆက်လက်လည်ပတ်ထားရန်"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsett å kjøre UTM etter at det siste vinduet er lukket og alle VM-er er slått av"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अन्तिम सञ्झ्याल बन्द भएपछि र सबै VM हरू बन्द भएपछि UTM चलिरहेको राख्नुहोस्"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd UTM actief nadat het laatste venster is gesloten en alle VM's zijn uitgeschakeld"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଶେଷ ୱିଣ୍ଡୋ ବନ୍ଦ ହେବା ଏବଂ ସମସ୍ତ VM ସଟ୍ ଡାଉନ୍ ହେବା ପରେ ମଧ୍ୟ UTM ଚାଲୁ ରଖନ୍ତୁ"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozostaw UTM uruchomiony po zamknięciu ostatniego okna i wyłączeniu wszystkich maszyn wirtualnych"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Manter o UTM em execução depois que a última janela for fechada e todas as VMs forem desligadas"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Menține UTM pornit după închiderea ultimei ferestre și oprirea tuturor mașinilor virtuale"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продолжение работы UTM после закрытия последнего окна и выключения всех ВМ"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخري ونڊو بند ٿيڻ ۽ سڀ VMs بند ٿيڻ کان پوءِ به UTM هلندو رکو"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "අවසාන කවුළුව වසා සියලු VM වසා දැමීමෙන් පසුව UTM ක්‍රියාත්මකව තබා ගන්න"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nechať UTM spustené po zatvorení posledného okna a vypnutí všetkých virtuálnych počítačov"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohrani UTM zagnan, ko je zadnje okno zaprto in so vsi navidezni računalniki zaustavljeni"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mbaj UTM në ekzekutim pasi të mbyllet dritarja e fundit dhe të fiken të gjitha VM-të"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Задржи UTM покренут након затварања последњег прозора и искључивања свих виртуелних машина"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fortsätt köra UTM efter att det sista fönstret har stängts och alla virtuella maskiner har stängts av"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endelea kuendesha UTM baada ya dirisha la mwisho kufungwa na mashine pepe zote kuzimwa"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "கடைசிச் சாளரம் மூடப்பட்டு, எல்லா VMகளும் ஷட் டவுன் செய்யப்பட்ட பிறகும் UTMஐ இயங்க வை"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "చివరి విండో మూసివేయబడిన తర్వాత మరియు అన్ని VMలు షట్ డౌన్ అయిన తర్వాత UTMని రన్ చేస్తూ ఉండండి"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ให้ UTM ทำงานต่อไปหลังจากปิดหน้าต่างสุดท้ายและ VM ทั้งหมดปิดเครื่องแล้ว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son pencere kapatıldıktan ve tüm VM'ler kapatıldıktan sonra UTM'yi çalışır durumda tut"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не завершувати роботу UTM після закриття останнього вікна й вимкнення всіх віртуальних машин"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آخری ونڈو بند ہونے اور تمام VMs بند ہونے کے بعد بھی UTM کو چلتا رہنے دیں"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oxirgi oyna yopilib, barcha VM-lar o'chirilgandan keyin ham UTM-ni ishlab turgan holda qoldirish"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Giữ UTM chạy sau khi cửa sổ cuối cùng được đóng và tất cả các máy ảo đều bị tắt"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在最後一個視窗關閉並且所有虛擬機關機時繼續執行 UTM"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在关闭最后一个窗口和所有虚拟机关机后继续运行 UTM"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
