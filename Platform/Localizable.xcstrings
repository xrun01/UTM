    "Tells the VM process to shut down with risk of data corruption. This simulates holding down the power button on a PC." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vertel die VM-proses om af te sluit met die risiko van datakorrupsie. Dit simuleer om die aan/uit-knoppie op 'n rekenaar in te hou."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخبر عملية الآلة الافتراضية بإيقاف التشغيل مع خطر تلف البيانات. هذا يحاكي الضغط مع الاستمرار على زر الطاقة في الكمبيوتر الشخصي."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ভিএম প্ৰক্ৰিয়াক ডাটা দুৰ্নীতিৰ আশংকাৰ সৈতে বন্ধ কৰিবলৈ কয়। ই এটা পিচিত পাৱাৰ বুটামটো টিপি ৰখাৰ অনুকৰণ কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM prosesinə məlumatların korlanması riski ilə bağlanmasını bildirir. Bu, kompüterdə güc düyməsini basıb saxlamağı simulyasiya edir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загадвае працэсу віртуальнай машыны спыніцца з рызыкай пашкоджання даных. Гэта імітуе ўтрыманне кнопкі харчавання на ПК."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Казва на VM процеса да се изключи с риск от повреда на данните. Това симулира задържане на бутона за захранване на компютър."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডেটা দুর্নীতির ঝুঁকি সহ VM প্রক্রিয়াটিকে বন্ধ করতে বলে৷ এটি একটি পিসিতে পাওয়ার বোতামটি ধরে রাখার অনুকরণ করে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaže VM procesu da se isključi uz rizik od oštećenja podataka. Ovo simulira držanje pritisnutog dugmeta za napajanje na računaru."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Indica al procés de la màquina virtual que es tanqui amb risc de corrupció de dades. Això simula mantenir premut el botó d'engegada d'un ordinador."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gisultihan ang proseso sa VM sa pagsira nga adunay peligro sa korapsyon sa datos. Kini nagsimbolo sa pagpugong sa power button sa usa ka PC."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Řekne procesu virtuálního počítače, aby se vypnul s rizikem poškození dat. To simuluje podržení tlačítka napájení na PC."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yn dweud wrth y broses VM i gau i lawr gyda risg o lygredd data. Mae hyn yn efelychu dal y botwm pŵer i lawr ar gyfrifiadur personol."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beder VM-processen om at lukke ned med risiko for datakorruption. Dette simulerer at holde tænd/sluk-knappen nede på en pc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Weist den VM-Prozess an, herunterzufahren, da das Risiko einer Datenbeschädigung besteht. Dies simuliert das Gedrückthalten des Netzschalters an einem PC."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Λέει στη διαδικασία VM να τερματιστεί με κίνδυνο καταστροφής δεδομένων. Αυτό προσομοιώνει το να κρατάτε πατημένο το κουμπί λειτουργίας σε έναν υπολογιστή."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica al proceso de la VM que se apague, con riesgo de corromper los datos. Esto simula mantener presionado el botón de apagado en una PC."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käsutab VM-i protsessi sulgema andmete riknemise ohuga. See simuleerib arvuti toitenupu all hoidmist."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM prozesuari datuak usteltzeko arriskuarekin itzaltzeko esaten dio. Honek ordenagailu batean pizteko botoia sakatuta mantentzea simulatzen du."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "به فرآیند VM می گوید که با خطر خراب شدن داده ها خاموش شود. این پایین نگه داشتن دکمه پاور را در رایانه شخصی شبیه سازی می کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käskee VM-prosessin sammumaan tietojen vioittumisen vaaran vuoksi. Tämä simuloi tietokoneen virtapainikkeen pitämistä painettuna."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Sinasabi sa proseso ng VM na i-shut down nang may panganib ng pagkasira ng data. Ginagaya nito ang pagpindot sa power button sa isang PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique au processus de la VM de s’arrêter avec un risque de corruption des données. Cela simule un appui prolongé sur le bouton d’alimentation du PC."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dille ao proceso da máquina virtual que se apague con risco de corrupción dos datos. Isto simula manter premido o botón de acendido nun PC."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ડેટા કરપ્શનના જોખમ સાથે VM પ્રક્રિયાને બંધ કરવાનું કહે છે. આ પીસી પર પાવર બટનને દબાવી રાખવાનું અનુકરણ કરે છે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "אומר לתהליך ה-VM להיסגר עם סיכון של השחתת נתונים. זה מדמה לחיצה ממושכת על לחצן ההפעלה במחשב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डेटा भ्रष्टाचार के जोखिम के साथ VM प्रक्रिया को बंद करने के लिए कहता है। यह एक पीसी पर पावर बटन को दबाए रखने का अनुकरण करता है।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kaže VM procesu da se isključi uz rizik od oštećenja podataka. Ovo simulira držanje tipke za napajanje na računalu."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utasítja a virtuális gépnek, hogy álljon le az adatsérülés kockázatával. Ez szimulálja a bekapcsológomb lenyomva tartását a számítógépen."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Պատմում է VM գործընթացին փակել տվյալների կոռուպցիայի վտանգի դեպքում: Սա նմանակում է համակարգչի միացման կոճակը սեղմած պահելը:"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Memberitahukan proses VM untuk dimatikan dengan risiko kerusakan data. Ini mensimulasikan menahan tombol daya pada PC."
          }
        },
        "is" : {
          "stringUnit" : {
