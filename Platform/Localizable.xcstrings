    "Force kill the VM process with high risk of data corruption." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beëindig die VM-proses geforseerd, met 'n hoë risiko van datakorrupsie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرض إنهاء عملية الآلة الافتراضية مع خطر كبير بتلف البيانات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "তথ্য নষ্ট হোৱাৰ উচ্চ আশংকা থকাকৈ VM ৰ প্ৰক্ৰিয়া বলপূৰ্বক সমাপ্ত কৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM prosesini məcburi sonlandırın, məlumatların korlanması riski yüksəkdir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Прымусова завяршыць працэс віртуальнай машыны з высокай рызыкай пашкоджання даных."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудително прекратяване на процеса на виртуалната машина с висок риск от повреда на данните."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "VM প্রসেস জোর করে কিল করুন। এতে ডেটা নষ্ট হওয়ার উচ্চ ঝুঁকি আছে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prisilno prekida proces virtuelne mašine, uz visok rizik od oštećenja podataka."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Força la finalització del procés de la màquina virtual, amb un risc alt de malmetre les dades."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puwersa nga patyon ang proseso sa VM nga adunay taas nga peligro sa korapsyon sa datos."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vynutí ukončení procesu virtuálního počítače s vysokým rizikem poškození dat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gorfodi lladd proses y VM, gyda risg uchel o lygru data."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tvangsafslut VM-processen med høj risiko for datakorruption."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beenden Sie den VM-Prozess sofort. Dabei besteht ein hohes Risiko einer Datenbeschädigung."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αναγκαστικός τερματισμός της διεργασίας της εικονικής μηχανής, με υψηλό κίνδυνο καταστροφής δεδομένων."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar el cierre del proceso de la VM, con alto riesgo de corromper los datos."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lõpetab VM-i protsessi sunniviisiliselt, andmete riknemise oht on suur."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hil makina birtualaren prozesua behartuta; datuak hondatzeko arrisku handia dago."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خاتمه اجباری فرایند ماشین مجازی با خطر بالای خرابی داده‌ها."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pakota virtuaalikoneen prosessin lopetus. Tietojen vioittumisen riski on suuri."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sapilitang patayin ang proseso ng VM, na may mataas na panganib na masira ang data."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force la fin du processus de la VM, avec un risque élevé de corruption des données."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar a finalización do proceso da máquina virtual, con alto risco de danar os datos."
          }
        },
        "gu" : {
          "stringUnit" : {
