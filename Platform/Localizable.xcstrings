    },
    "The amount of storage to allocate for this image. Ignored if importing an image. If this is a raw image, then an empty file of this size will be stored with the VM. Otherwise, the disk image will dynamically expand up to this size." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die hoeveelheid berging om vir hierdie beeld toe te ken. Word geïgnoreer as 'n beeld ingevoer word. As dit 'n rou beeld is, word 'n leë lêer van hierdie grootte saam met die VM gestoor. Andersins brei die skyfbeeld dinamies uit tot hierdie grootte."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حجم التخزين المخصص لهذه الصورة. يتم تجاهله عند استيراد صورة. إذا كانت هذه صورة خام، فسيتم تخزين ملف فارغ بهذا الحجم مع الآلة الافتراضية. خلاف ذلك، ستتوسع صورة القرص ديناميكيًا حتى هذا الحجم."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ইমেজৰ বাবে আবণ্টন কৰিবলগীয়া ষ্ট'ৰেজৰ পৰিমাণ। ইমেজ আমদানি কৰিলে ইয়াক আওকাণ কৰা হয়। এইটো RAW ইমেজ হ'লে এই আকাৰৰ এটা খালী ফাইল VM ৰ সৈতে সংৰক্ষণ কৰা হ'ব। অন্যথা ডিষ্ক ইমেজটো প্ৰয়োজন অনুসৰি এই আকাৰলৈকে বাঢ়িব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu obraz üçün ayrılacaq yaddaş sahəsinin həcmi. Obraz idxal edilərkən nəzərə alınmır. Bu xam obrazdırsa, bu ölçüdə boş fayl VM ilə birlikdə saxlanacaq. Əks halda disk obrazı dinamik olaraq bu ölçüyə qədər genişlənəcək."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Аб'ём сховішча, які трэба вылучыць для гэтага вобраза. Ігнаруецца пры імпарце вобраза. Калі гэта неапрацаваны вобраз, разам з віртуальнай машынай будзе захоўвацца пусты файл такога памеру. Інакш вобраз дыска будзе дынамічна павялічвацца да гэтага памеру."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обемът на мястото за съхранение, което да се задели за този образ. Не се взема предвид при импортиране на образ. Ако това е необработен образ, с виртуалната машина ще бъде съхранен празен файл с този размер. В противен случай дисковият образ ще се разширява динамично до този размер."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এই ইমেজের জন্য কতটা স্টোরেজ বরাদ্দ করা হবে। ইমেজ আমদানি করলে এটি উপেক্ষা করা হয়। এটি RAW ইমেজ হলে, এই আকারের একটি খালি ফাইল VM-এর সাথে সংরক্ষণ করা হবে। না হলে, ডিস্ক ইমেজটি প্রয়োজন অনুযায়ী এই আকার পর্যন্ত বাড়বে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Količina prostora za pohranu koja se dodjeljuje ovoj slici. Zanemaruje se pri uvozu slike. Ako je ovo raw slika, prazna datoteka ove veličine čuvat će se zajedno s virtuelnom mašinom. U suprotnom, slika diska dinamički će se proširivati do ove veličine."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quantitat d'emmagatzematge a assignar per a aquesta imatge. S'ignora si s'importa una imatge. Si es tracta d'una imatge en brut, s'emmagatzemarà un fitxer buit d'aquesta mida amb la màquina virtual. En cas contrari, la imatge del disc s'ampliarà dinàmicament fins a aquesta mida."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang gidaghanon sa storage nga igahin alang niini nga image. Dili kini gamiton kung nag-import og image. Kung raw image kini, usa ka walay sulod nga file nga ingon niini kadako ang itipig uban sa VM. Kung dili, ang disk image modako sa dinamikong paagi hangtod niini nga gidak-on."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Velikost úložiště, které se pro tento obraz vyhradí. Při importu obrazu se ignoruje. Pokud jde o obraz typu raw, uloží se s virtuálním počítačem prázdný soubor této velikosti. Jinak se obraz disku bude dynamicky zvětšovat až na tuto velikost."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faint o le storio i'w ddyrannu ar gyfer y ddelwedd hon. Wedi'i anwybyddu os yn mewnforio delwedd. Os yw hwn yn ddelwedd amrwd, yna bydd ffeil wag o'r maint hwn yn cael ei storio gyda'r VM. Fel arall, bydd delwedd y ddisg yn ehangu hyd at y maint hwn yn ddeinamig."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mængden af lagerplads, der skal allokeres til dette billede. Ignoreres ved import af et billede. Hvis dette er et råbillede, vil en tom fil af denne størrelse blive gemt med VM'en. Ellers udvides diskbilledet dynamisk op til denne størrelse."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Speicherplatz, der für dieses Image reserviert wird. Wird beim Importieren eines Images ignoriert. Bei einem Raw-Image wird eine leere Datei dieser Größe mit der VM gespeichert. Andernfalls wächst das Laufwerksimage dynamisch bis zu dieser Größe."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ο χώρος αποθήκευσης που θα δεσμευτεί για αυτήν την εικόνα. Αγνοείται κατά την εισαγωγή εικόνας. Αν πρόκειται για ακατέργαστη εικόνα, θα αποθηκευτεί μαζί με την εικονική μηχανή ένα κενό αρχείο αυτού του μεγέθους. Διαφορετικά, η εικόνα δίσκου θα επεκτείνεται δυναμικά έως αυτό το μέγεθος."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cantidad de almacenamiento para asignar a esta imagen. Se ignora si la imagen es importada. Si es una imagen bruta, entonces se almacenará un archivo vacío de este tamaño con la VM. De otro modo, la imagen de disco se expandirá dinámicamente hasta este tamaño."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selle tõmmise jaoks eraldatav salvestusruumi maht. Tõmmise importimisel seda ei arvestata. Kui see on toortõmmis, salvestatakse VM-iga koos selle suurusega tühi fail. Vastasel juhul laieneb kettatõmmis dünaamiliselt kuni selle suuruseni."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Irudi honi esleitu beharreko biltegiratze-kopurua. Ez ikusi egingo da irudi bat inportatuz gero. Irudi gordina bada, tamaina horretako fitxategi huts bat gordeko da makina birtualarekin. Bestela, disko-irudia dinamikoki zabalduko da tamaina honetaraino."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مقدار فضای ذخیره‌سازی که به این ایمیج اختصاص داده می‌شود. هنگام وارد کردن ایمیج نادیده گرفته می‌شود. اگر این ایمیج خام باشد، یک فایل خالی با این اندازه همراه ماشین مجازی ذخیره می‌شود. در غیر این صورت، ایمیج دیسک به‌صورت پویا تا این اندازه بزرگ می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tälle levykuvalle varattava tallennustila. Ei käytetä, jos levykuva tuodaan. Jos tämä on raakalevykuva, tämän kokoinen tyhjä tiedosto tallennetaan virtuaalikoneen mukana. Muuten levykuva kasvaa tarpeen mukaan enintään tähän kokoon."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang dami ng storage na ilalaan para sa image na ito. Binabalewala ito kapag nag-import ng image. Kung raw image ito, maiimbak kasama ng VM ang isang walang laman na file na ganito kalaki. Kung hindi, dynamic na lalaki ang disk image hanggang sa ganitong laki."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quantité de stockage à allouer pour cette image. Ignoré si importation d’image. Si c'est une image brute, un fichier vide de la même taille sera enregistré avec la VM. Sinon, l’image disque sera dynamiquement étendue jusqu’à cette taille."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantidade de almacenamento que se asigna a esta imaxe. Ignórase se se importa unha imaxe. Se é unha imaxe en bruto, almacenarase coa máquina virtual un ficheiro baleiro deste tamaño. En caso contrario, a imaxe de disco expandirase dinamicamente ata este tamaño."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આ ઇમેજ માટે ફાળવવાના સ્ટોરેજનો જથ્થો. ઇમેજ આયાત કરતી વખતે આ મૂલ્ય અવગણવામાં આવે છે. જો આ રૉ ઇમેજ હોય, તો આ કદની ખાલી ફાઇલ VM સાથે સંગ્રહિત થશે. નહિંતર, ડિસ્ક ઇમેજ ડાયનેમિક રીતે આ કદ સુધી વધશે."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "כמות האחסון שיש להקצות לתמונה זו. הערך לא משמש בעת ייבוא תמונה. אם זו תמונה גולמית, קובץ ריק בגודל זה יאוחסן עם ה-VM. אחרת, תמונת הדיסק תתרחב באופן דינמי עד לגודל זה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इस इमेज के लिए आवंटित किए जाने वाले स्टोरेज की मात्रा। इमेज इंपोर्ट करते समय इसे अनदेखा किया जाता है। अगर यह रॉ इमेज है, तो इस आकार की एक खाली फ़ाइल VM के साथ संग्रहीत की जाएगी। अन्यथा, डिस्क इमेज डायनेमिक रूप से इस आकार तक बढ़ेगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Količina prostora za pohranu koju treba dodijeliti ovoj slici. Ignorira se ako se uvozi slika. Ako je ovo neobrađena slika, tada će prazna datoteka ove veličine biti pohranjena s VM-om. U suprotnom, slika diska će se dinamički proširiti do ove veličine."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A lemezképnek lefoglalandó tárhely mérete. Lemezkép importálásakor nincs hatása. Nyers lemezkép esetén ilyen méretű üres fájl lesz tárolva a virtuális géppel. Egyéb esetben a lemezkép dinamikusan bővül legfeljebb erre a méretre."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Այս պատկերի համար հատկացվող պահեստի ծավալը։ Պատկեր ներմուծելիս անտեսվում է։ Եթե սա չմշակված պատկեր է, ապա այս չափի դատարկ ֆայլ կպահվի վիրտուալ մեքենայի հետ։ Հակառակ դեպքում սկավառակի պատկերը դինամիկ կերպով կընդլայնվի մինչև այս չափը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah ruang penyimpanan yang dialokasikan untuk citra ini. Diabaikan jika mengimpor citra. Jika ini citra mentah, file kosong sebesar ini akan disimpan bersama VM. Jika tidak, citra disk akan membesar secara dinamis hingga ukuran ini."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Magn geymslurýmis sem á að úthluta fyrir þessa diskmynd. Hunsað ef diskmynd er flutt inn. Ef þetta er hrá diskmynd verður tóm skrá af þessari stærð geymd með sýndarvélinni. Annars stækkar diskmyndin eftir þörfum upp í þessa stærð."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quantità di spazio da allocare per questa immagine. Viene ignorata se si importa un'immagine. Se è un'immagine raw, con la VM verrà salvato un file vuoto di questa dimensione. Altrimenti, l'immagine disco si espanderà dinamicamente fino a questa dimensione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このイメージに割り当てるストレージ領域です。イメージを読み込む場合は無視されます。生イメージの場合、このサイズの空のファイルが仮想マシンに保存されます。そうでない場合、ディスクイメージはこのサイズまで動的に拡張されます。"
          }
        },
        "jv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah panyimpenan sing dialokasekake kanggo citra iki. Ora digatekake yen ngimpor citra. Yen iki citra mentah, file kosong kanthi ukuran iki bakal disimpen karo VM. Yen ora, citra disk bakal nggedhe kanthi dinamis nganti ukuran iki."
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ამ იმიჯისთვის გამოსაყოფი საცავის მოცულობა. იმიჯის იმპორტისას იგნორირდება. თუ ეს raw იმიჯია, ამ ზომის ცარიელი ფაილი შეინახება ვირტუალურ მანქანასთან ერთად. წინააღმდეგ შემთხვევაში, დისკის იმიჯი დინამიკურად გაფართოვდება ამ ზომამდე."
          }
        },
        "kk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Бұл кескінге бөлінетін сақтау орнының көлемі. Кескінді импорттағанда еленбейді. Бұл өңделмеген кескін болса, осы өлшемдегі бос файл виртуалды машинамен бірге сақталады. Әйтпесе, диск кескіні осы өлшемге дейін динамикалық түрде кеңейеді."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ទំហំផ្ទុកដែលត្រូវបែងចែកសម្រាប់ឯកសាររូបភាពនេះ។ មិនប្រើទេ ប្រសិនបើនាំចូលឯកសាររូបភាព។ ប្រសិនបើនេះជាឯកសាររូបភាពឆៅ ឯកសារទទេដែលមានទំហំនេះនឹងត្រូវបានរក្សាទុកជាមួយ VM។ បើមិនដូច្នោះទេ ឯកសាររូបភាពថាសនឹងពង្រីកដោយថាមវន្តរហូតដល់ទំហំនេះ។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಈ ಇಮೇಜ್‌ಗೆ ನಿಗದಿಪಡಿಸಬೇಕಾದ ಸಂಗ್ರಹಣೆಯ ಪ್ರಮಾಣ. ಇಮೇಜ್ ಅನ್ನು ಆಮದು ಮಾಡುತ್ತಿದ್ದರೆ ಇದನ್ನು ನಿರ್ಲಕ್ಷಿಸಲಾಗುತ್ತದೆ. ಇದು raw ಇಮೇಜ್ ಆಗಿದ್ದರೆ, ಈ ಗಾತ್ರದ ಖಾಲಿ ಫೈಲ್ ಅನ್ನು VMನೊಂದಿಗೆ ಸಂಗ್ರಹಿಸಲಾಗುತ್ತದೆ. ಇಲ್ಲದಿದ್ದರೆ, ಡಿಸ್ಕ್ ಇಮೇಜ್ ಈ ಗಾತ್ರದವರೆಗೆ ಡೈನಾಮಿಕ್ ಆಗಿ ವಿಸ್ತರಿಸುತ್ತದೆ."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 이미지에 할당할 저장 공간의 크기를 지정합니다. 이미지를 가져오는 경우 이 값은 무시됩니다. Raw 이미지인 경우, 이 크기의 빈 파일이 가상 머신과 함께 저장됩니다. 그렇지 않으면 디스크 이미지는 이 크기까지 동적으로 확장됩니다."
          }
        },
        "lb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D'Späicherplaz, déi dësem Image zougedeelt gëtt. Gëtt ignoréiert, wann en Image importéiert gëtt. Bei engem RAW-Image gëtt en eidele Fichier vun dëser Gréisst mat der VM gespäichert. Soss wiisst d'Disk-Image dynamesch bis op dës Gréisst."
          }
        },
        "lo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ຂະໜາດພື້ນທີ່ເກັບຂໍ້ມູນທີ່ຈະຈັດສັນໃຫ້ອິມເມຈນີ້. ຈະຖືກລະເລີຍເມື່ອນຳເຂົ້າອິມເມຈ. ຖ້າເປັນອິມເມຈ raw, ໄຟລ໌ເປົ່າຂະໜາດນີ້ຈະຖືກເກັບໄວ້ກັບ VM. ຖ້າບໍ່ແມ່ນ, ອິມເມຈດິສກ໌ຈະຂະຫຍາຍແບບໄດນາມິກຈົນເຖິງຂະໜາດນີ້."
          }
        },
        "lt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiek saugyklos skirti šiam atvaizdui. Importuojant atvaizdą nepaisoma. Jei tai neapdorotas atvaizdas, kartu su VM bus saugomas tuščias tokio dydžio failas. Kitu atveju disko atvaizdas dinamiškai didės iki šio dydžio."
          }
        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krātuves apjoms, kas jāpiešķir šim attēlam. Tiek ignorēts, importējot attēlu. Ja šis ir neapstrādāts attēls, kopā ar virtuālo mašīnu tiks saglabāts tukšs šāda izmēra fails. Pretējā gadījumā diska attēls dinamiski paplašināsies līdz šim izmēram."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количина на складиштен простор што ќе се додели за оваа слика. Се игнорира ако се увезува слика. Ако ова е необработена слика, со виртуелната машина ќе се зачува празна датотека со оваа големина. Во спротивно, сликата на дискот динамички ќе се проширува до оваа големина."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "या इमेजसाठी वाटप करायचे स्टोरेज. इमेज इम्पोर्ट करत असल्यास याकडे दुर्लक्ष केले जाते. ही रॉ इमेज असल्यास, या आकाराची रिकामी फाइल VM सोबत संग्रहित केली जाईल. अन्यथा, डिस्क इमेज गरजेनुसार या आकारापर्यंत वाढेल."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jumlah storan yang diperuntukkan bagi imej ini. Diabaikan jika mengimport imej. Jika ini imej mentah, fail kosong sebesar saiz ini akan disimpan bersama VM. Jika tidak, imej cakera akan berkembang secara dinamik sehingga saiz ini."
          }
        },
        "mt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L-ammont ta' ħażna li għandu jiġi allokat għal din l-immaġni. Jiġi injorat jekk qed timporta immaġni. Jekk din hija immaġni raw, fajl vojt ta' dan id-daqs jinħażen mal-magna virtwali. Inkella, l-immaġni tad-diska tespandi b'mod dinamiku sa dan id-daqs."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤအင်မေ့ချ်အတွက် ခွဲဝေမည့် သိုလှောင်ခန်း ပမာဏ။ အင်မေ့ချ်ကို တင်သွင်းပါက ဤတန်ဖိုးကို လျစ်လျူရှုသည်။ raw အင်မေ့ချ် ဖြစ်ပါက ဤအရွယ်အစားရှိ ဖိုင်အလွတ်ကို ဗာချွယ်စက်နှင့်အတူ သိမ်းဆည်းမည်။ မဟုတ်ပါက ဒစ်ခ်အင်မေ့ချ်သည် ဤအရွယ်အစားအထိ လိုအပ်သလို ကြီးထွားမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvor mye lagringsplass som skal tildeles dette bildet. Ignoreres ved import av et bilde. Hvis dette er et råbilde, lagres en tom fil av denne størrelsen sammen med VM-en. Ellers utvides diskbildet dynamisk opp til denne størrelsen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यो इमेजका लागि छुट्याउने भण्डारणको मात्रा। इमेज आयात गर्दा यसलाई बेवास्ता गरिन्छ। यो raw इमेज हो भने, यो आकारको खाली फाइल VM सँग भण्डारण गरिनेछ। अन्यथा, डिस्क इमेज यो आकारसम्म गतिशील रूपमा बढ्नेछ।"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De hoeveelheid opslagruimte die voor deze schijfkopie wordt toegewezen. Wordt genegeerd bij het importeren van een schijfkopie. Als dit een raw-schijfkopie is, wordt een leeg bestand van deze grootte bij de VM opgeslagen. Anders wordt de schijfkopie dynamisch uitgebreid tot deze grootte."
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ଏହି ଇମେଜ୍ ପାଇଁ ଆବଣ୍ଟନ କରିବାକୁ ଥିବା ଷ୍ଟୋରେଜ୍‌ର ପରିମାଣ। ଇମେଜ୍ ଇମ୍ପୋର୍ଟ୍ କଲେ ଏହାକୁ ଅଣଦେଖା କରାଯାଏ। ଏହା ଏକ RAW ଇମେଜ୍ ହୋଇଥିଲେ, ଏହି ଆକାରର ଏକ ଖାଲି ଫାଇଲ୍ VM ସହିତ ରଖାଯିବ। ଅନ୍ୟଥା, ଡିସ୍କ୍ ଇମେଜ୍ ଆବଶ୍ୟକତା ଅନୁସାରେ ଏହି ଆକାର ପର୍ଯ୍ୟନ୍ତ ବଢ଼ିବ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilość pamięci masowej do przydzielenia dla tego obrazu. Ignorowane, jeśli importujesz obraz. Jeśli jest to surowy obraz, wtedy pusty plik tego rozmiaru będzie przechowywany wraz z maszyną wirtualną. W przeciwnym wypadku obraz dysku będzie dynamicznie się rozszerzał do tego rozmiaru."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quantidade de armazenamento a ser alocada para esta imagem. Ignorado ao importar uma imagem. Se esta for uma imagem bruta, um arquivo vazio deste tamanho será armazenado com a VM. Caso contrário, a imagem do disco será expandida dinamicamente até esse tamanho."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cantitatea de stocare care trebuie alocată pentru această imagine. Ignorată dacă se importă o imagine. Dacă aceasta este o imagine brută, atunci un fișier gol de această dimensiune va fi stocat împreună cu mașina virtuală. În caz contrar, imaginea de disc se va extinde dinamic până la această dimensiune."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Объем дискового пространства, выделяемый для данного образа. Игнорируется при импорте образа. Если это необработанный образ, то вместе с ВМ будет сохранен пустой файл такого размера. В противном случае образ диска будет динамически расширяться до этого размера."
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هن اميج لاءِ مختص ٿيندڙ اسٽوريج جي مقدار. اميج درآمد ڪرڻ وقت هي نظرانداز ٿيندي. جيڪڏهن هي خام اميج آهي، ته هن سائيز جي هڪ خالي فائل VM سان گڏ محفوظ ڪئي ويندي. ٻي صورت ۾، ڊسڪ اميج متحرڪ طور هن سائيز تائين وڌندي."
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙම ඉමේජ් ගොනුව සඳහා වෙන් කළ යුතු ආචයන ප්‍රමාණය. ඉමේජ් ගොනුවක් ආයාත කරන්නේ නම් මෙය නොසලකා හරිනු ලැබේ. මෙය අමු ඉමේජ් ගොනුවක් නම්, මෙම ප්‍රමාණයේ හිස් ගොනුවක් VM සමඟ ගබඩා කෙරේ. එසේ නොමැති නම්, තැටි ඉමේජ් ගොනුව මෙම ප්‍රමාණය දක්වා ගතිකව ප්‍රසාරණය වේ."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veľkosť úložiska, ktorá sa má prideliť tomuto obrazu. Pri importovaní obrazu sa ignoruje. Ak ide o nespracovaný obraz, s virtuálnym počítačom sa uloží prázdny súbor tejto veľkosti. V opačnom prípade sa obraz disku bude dynamicky zväčšovať až do tejto veľkosti."
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Količina prostora, ki se dodeli tej sliki. Pri uvozu slike se prezre. Če je to neobdelana slika, bo skupaj z navideznim računalnikom shranjena prazna datoteka te velikosti. V nasprotnem primeru se bo slika diska dinamično povečevala do te velikosti."
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sasia e hapësirës ruajtëse për të ndarë për këtë imazh. Injorohet nëse importohet një imazh. Nëse ky është një imazh i papërpunuar, atëherë një skedar bosh i kësaj madhësie do të ruhet me VM. Përndryshe, imazhi i diskut do të zgjerohet dinamikisht deri në këtë madhësi."
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Количина простора за складиштење која се додељује овој слици. Занемарује се ако се слика увози. Ако је ово необрађена слика, празна датотека ове величине биће сачувана уз виртуелну машину. У супротном, слика диска ће се динамички проширивати до ове величине."
          }
