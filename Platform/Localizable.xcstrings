        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ցանկանու՞մ եք այս վիրտուալ մեքենան տեղափոխել այլ վայր։ Տվյալները կպատճենվեն նոր վայր, կջնջվեն սկզբնական վայրից, և այնուհետև կստեղծվի դյուրանցում։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apakah Anda ingin memindahkan VM ini ke lokasi lain? Ini akan menyalin data ke lokasi baru, menghapus data dari lokasi asli, dan kemudian membuat pintasan."
