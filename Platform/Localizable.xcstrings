        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در صورت فعال بودن، همه ایمیج‌های درایو قابل‌نوشتن هنگام اجرای ماشین مجازی قفل می‌شوند. ایمیج‌های درایو فقط‌خواندنی قفل نمی‌شوند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jos tämä on käytössä, kaikki kirjoitettavat aseman levykuvat lukitaan, kun virtuaalikone on käynnissä. Vain luku -tilassa olevia aseman levykuvia ei lukita."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kung naka-enable, mala-lock ang lahat ng writable na drive image habang tumatakbo ang VM. Hindi mala-lock ang mga read-only na drive image."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si cette option est activée, toutes les images de lecteur inscriptibles seront verrouillées lorsque la VM est en cours d'exécution. Les images de lecteur en lecture seule ne seront pas verrouillées."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se está activado, todas as imaxes de unidade gravables bloquearanse cando a máquina virtual estea en execución. As imaxes da unidade de só lectura non se bloquearán."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "જો સક્ષમ હોય, તો VM ચાલતું હોય ત્યારે લખી શકાય તેવી બધી ડ્રાઇવ ઇમેજ લૉક થઈ જશે. ફક્ત વાંચવા માટેની ડ્રાઇવ ઇમેજ લૉક થશે નહીં."
