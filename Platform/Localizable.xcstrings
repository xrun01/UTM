    "When cloning a VM, regenerate MAC addresses on every network interface to prevent conflicts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عند استنساخ جهاز افتراضي، قم بإعادة إنشاء عناوين MAC على كل واجهة شبكة لمنع التعارضات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Generieren Sie beim Klonen einer VM MAC-Adressen auf jeder Netzwerkschnittstelle neu, um Konflikte zu vermeiden."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Al clonar una máquina virtual, regenere las direcciones MAC en cada interfaz de red para evitar conflictos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kun kloonaat VM:tä, luo uudelleen MAC-osoitteet jokaisessa verkkoliitännässä ristiriitojen välttämiseksi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lors du clonage d'une VM, régénérez les adresses MAC sur chaque interface réseau pour éviter les conflits."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Quando cloni una VM, rigenera gli indirizzi MAC su ogni interfaccia di rete per prevenire conflitti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM のクローンを作成するときは、競合を防ぐためにすべてのネットワーク インターフェイスで MAC アドレスを再生成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM을 복제할 때 충돌을 방지하기 위해 모든 네트워크 인터페이스에서 MAC 주소를 다시 생성합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Podczas klonowania maszyny wirtualnej należy ponownie wygenerować adresy MAC na każdym interfejsie sieciowym, aby zapobiec konfliktom."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "При клонировании виртуальной машины повторно создайте MAC-адреса на каждом сетевом интерфейсе, чтобы предотвратить конфликты."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "製作虛擬機副本時，為避免衝突，對於每個網絡介面重新產生 MAC 位址。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "克隆虚拟机时，对每个网络接口重新生成 MAC 地址，以避免产生冲突。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "複製虛擬機器時，在每個網路介面上重新產生 MAC 位址以防止衝突。"
          }
        }
      }
    },
