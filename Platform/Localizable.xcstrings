        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "僅能開機進入由 Microsoft 或受信任廠商簽署的作業系統。支援大多數主要的 Linux 發行版。"
          }
        }
      }
    },
