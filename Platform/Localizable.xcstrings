        },
        "sl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posnetka »%@« ni mogoče obnoviti, ker ne zajema vseh pogonov navideznega računalnika, na primer pogona, dodanega po nastanku posnetka."
