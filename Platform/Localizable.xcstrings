            "value" : "ဤဗာချွယ်စက်အတွက် လျှပ်တစ်ပြက်မှတ်တမ်းများကို ပံ့ပိုးမထားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Øyeblikksbilder støttes ikke for denne virtuelle maskinen."
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यस भर्चुअल मेसिनको लागि स्न्यापसटहरू समर्थित छैनन्।"
          }
        },
        "nl" : {
          "stringUnit" : {
