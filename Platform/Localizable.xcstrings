    "Sends power down request to the guest. This simulates pressing the power button on a PC." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل طلب إيقاف تشغيل الطاقة إلى الضيف. هذا يحاكي الضغط على زر الطاقة على الكمبيوتر الشخصي."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enviar solicitud de apagado al invitado. Esto simula presionar el botón de apagado en una PC."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une requête d’extinction à l’invité. Cela simule un appui sur le bouton d’alimentation du PC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia la richiesta di spegnimento al Guest. Questo simula la pressione del tasto di accensione su un PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ゲストに電源オフ要求を送信します。これにより、PCの電源ボタン押下をシミュレートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "게스트에게 전원을 끄라는 요청을 보냅니다. 이는 PC의 전원 버튼을 짧게 누르는 행동을 흉내냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyła żądanie do systemu gościa o zamknięcie systemu. Symuluje to naciśnięcie przycisku zasilania na komputerze."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Отправляет гостю запрос на выключение питания. Это имитирует нажатие кнопки питания на ПК."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "傳送關閉電源要求至客户端。此操作模擬了按一下 PC 上的電源按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "向客户机发送关闭电源请求。此操作模拟了按下 PC 上的电源按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將關機請求送往客體，模擬按下 PC 的關機鍵。"
          }
        }
      }
    },
