        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz, czy UTM ma zapisywać stan uruchomionych maszyn wirtualnych, czy żądać zamknięcia ich systemów operacyjnych gościa po zamknięciu UTM."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Escolha se o UTM salva o estado das máquinas virtuais em execução ou solicita que seus sistemas operacionais convidados sejam desligados quando o UTM é encerrado."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Alegeți dacă UTM salvează starea mașinilor virtuale care rulează sau solicită ca sistemele lor de operare invitate să se închidă când UTM se închide."
