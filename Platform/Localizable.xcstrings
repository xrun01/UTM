        },
        "lv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tas var sabojāt virtuālo mašīnu, un visas nesaglabātās izmaiņas tiks zaudētas. Lai droši izietu, izslēdziet viesa sistēmu."
          }
        },
        "mk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ова може да ја оштети виртуелната машина и сите незачувани промени ќе бидат изгубени. За безбедно излегување, исклучете ја од гостинскиот систем."
          }
        },
        "mr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "यामुळे VM दूषित होऊ शकते आणि कोणतेही जतन न केलेले बदल गमावले जातील. सुरक्षितपणे बाहेर पडण्यासाठी, गेस्टमधून शट डाउन करा."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ini mungkin merosakkan VM dan sebarang perubahan yang tidak disimpan akan hilang. Untuk keluar dengan selamat, matikan daripada tetamu."
