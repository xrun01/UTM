        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "దీన్ని మార్చడానికి, షేర్ చేసిన డైరెక్టరీని తీసివేసి, మళ్లీ జోడించండి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "หากต้องการเปลี่ยนแปลง ให้เอาไดเรกทอรีที่แชร์ออกแล้วเพิ่มอีกครั้ง"
