    "Space cannot be reclaimed from a drive while it holds snapshots or a suspended state." : {
      "comment" : "UTMData",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن استعادة المساحة من محرك الأقراص أثناء احتوائه على لقطات أو حالة تعليق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Von einem Laufwerk kann kein Speicherplatz zurückgewonnen werden, während es Snapshots enthält oder sich im Ruhezustand befindet."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se puede recuperar espacio de una unidad mientras contiene instantáneas o está suspendida."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tilaa ei voi ottaa takaisin asemalta, kun siinä on tilannekuvia tai keskeytetty tila."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'espace ne peut pas être récupéré sur un disque lorsqu'il contient des instantanés ou est dans un état suspendu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è possibile recuperare spazio da un'unità mentre contiene istantanee o è in stato sospeso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドライブがスナップショットまたはサスペンド状態を保持している間は、ドライブからスペースを再利用することはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "스냅샷이 보관되어 있거나 일시 중단된 상태인 드라이브에서는 공간을 회수할 수 없습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie można odzyskać miejsca na dysku, gdy znajdują się na nim migawki lub stan zawieszenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Пространство не может быть освобождено с диска, пока на нем хранятся снимки или в приостановленном состоянии."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁碟存有快照或擱置狀態時，無法回收其空間。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "驱动器包含快照或挂起状态时，无法回收它的空间。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "當磁碟機保存快照或掛起狀態時，無法從磁碟機回收空間。"
          }
        }
      }
    },
