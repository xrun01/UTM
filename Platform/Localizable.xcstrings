    "AmigaOS" : {
      "shouldTranslate" : false
    },
    "An IPSW recovery image must be specified to create a macOS virtual machine." : {
      "comment" : "UTMScriptingAppDelegate",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "'n IPSW-herstelbeeld moet gespesifiseer word om 'n virtuele macOS-masjien te skep."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب تحديد صورة استرداد IPSW لإنشاء آلة افتراضية تعمل بنظام macOS."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এটা macOS ভাৰ্চুৱেল মেচিন সৃষ্টি কৰিবলৈ এটা IPSW ৰিকভাৰী ইমেজ ধাৰ্য্য কৰিব লাগিব।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS virtual maşını yaratmaq üçün IPSW bərpa obrazı göstərilməlidir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для стварэння віртуальнай машыны macOS неабходна ўказаць вобраз аднаўлення IPSW."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да създадете виртуална машина macOS, трябва да посочите IPSW образ за възстановяване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ভার্চুয়াল মেশিন তৈরি করতে একটি IPSW রিকভারি ইমেজ অবশ্যই নির্দিষ্ট করতে হবে।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW slika za oporavak mora biti navedena za kreiranje macOS virtuelne mašine."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S'ha d'especificar una imatge de recuperació IPSW per crear una màquina virtual macOS."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kinahanglang itakda ang usa ka IPSW recovery image aron makahimo og macOS virtual machine."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "K vytvoření virtuálního počítače macOS je nutné zadat obraz IPSW pro zotavení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rhaid nodi delwedd adfer IPSW i greu peiriant rhithwir macOS."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et IPSW-gendannelsesbillede skal angives for at oprette en virtuel macOS-maskine."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Erstellen einer virtuellen macOS-Maschine muss ein IPSW-Wiederherstellungsimage angegeben werden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Πρέπει να καθοριστεί μια εικόνα ανάκτησης IPSW για τη δημιουργία μιας εικονικής μηχανής macOS."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se debe especificar una imagen de recuperación IPSW para crear una máquina virtual macOS."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS-i virtuaalmasina loomiseks tuleb määrata IPSW-taastetõmmis."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW berreskuratzeko irudi bat zehaztu behar da macOS makina birtual bat sortzeko."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای ایجاد ماشین مجازی macOS باید یک ایمیج بازیابی IPSW مشخص شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IPSW-palautuskuva on määritettävä macOS-virtuaalikoneen luomiseksi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dapat tukuyin ang isang IPSW recovery image para gumawa ng macOS virtual machine."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
