        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instantaneul „%@” nu poate fi restaurat deoarece nu acoperă toate unitățile mașinii virtuale, de exemplu o unitate adăugată după crearea instantaneului."
