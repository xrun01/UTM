    "This may corrupt the VM and any unsaved changes will be lost. To quit safely, shut down from the guest." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit kan die VM beskadig en enige ongestoorde veranderinge sal verlore gaan. Om veilig te verlaat, skakel die gas vanuit die gasstelsel af."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يتسبب هذا في تلف الآلة الافتراضية وأي تغييرات غير محفوظة ستفقد. للخروج بأمان، قم بإيقاف التشغيل من الضيف."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ইয়াৰ ফলত VM নষ্ট হ'ব পাৰে আৰু সংৰক্ষণ নকৰা সকলো পৰিবৰ্তন হেৰাই যাব। নিৰাপদে প্ৰস্থান কৰিবলৈ অতিথি চিস্টেমৰ ভিতৰৰ পৰা বন্ধ কৰক।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu, VM-i korlaya bilər və yadda saxlanmamış bütün dəyişikliklər itiriləcək. Təhlükəsiz çıxmaq üçün qonaq sisteminin içindən söndürün."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Гэта можа пашкодзіць віртуальную машыну, і ўсе незахаваныя змены будуць страчаны. Каб бяспечна выйсці, выключыце гасцявую сістэму."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Това може да повреди виртуалната машина и всички незапазени промени ще бъдат загубени. За да излезете безопасно, изключете от гостуващата система."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এতে VM নষ্ট হতে পারে এবং অসংরক্ষিত পরিবর্তনগুলি হারিয়ে যাবে। নিরাপদে প্রস্থান করতে গেস্ট থেকে শাট ডাউন করুন।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ovo može oštetiti virtuelnu mašinu, a sve nesačuvane promjene bit će izgubljene. Da biste sigurno izašli, isključite virtuelnu mašinu iz gostujućeg sistema."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Això pot malmetre la màquina virtual i es perdran els canvis no desats. Per sortir de manera segura, apagueu el sistema des del convidat."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mahimong makadaot kini sa VM ug mawala ang bisan unsang pagbag-o nga wala ma-save. Aron luwas nga moundang, ipalong gikan sa guest."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Virtuální počítač se může poškodit a všechny neuložené změny budou ztraceny. Pro bezpečné ukončení ho vypněte z hostovaného systému."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gall hyn lygru'r VM a bydd unrhyw newidiadau heb eu cadw yn cael eu colli. I adael yn ddiogel, caewch i lawr o'r gwestai."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dette kan ødelægge VM'en, og eventuelle ikke-gemte ændringer vil gå tabt. For at afslutte sikkert skal du lukke ned fra gæsten."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch kann die VM beschädigt werden, und nicht gespeicherte Änderungen gehen verloren. Fahren Sie die VM über das Gastsystem herunter, um sie sicher zu beenden."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Αυτό μπορεί να καταστρέψει την εικονική μηχανή και τυχόν μη αποθηκευμένες αλλαγές θα χαθούν. Για ασφαλή έξοδο, τερματίστε τη λειτουργία από το σύστημα επισκέπτη."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede corromper la VM y se perderá cualquier cambio no guardado. Para salir con seguridad, apaga la VM desde el invitado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See võib VM-i rikkuda ja kõik salvestamata muudatused lähevad kaotsi. Ohutuks väljumiseks lülitage VM välja külalissüsteemis."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Honek makina birtuala honda dezake, eta gorde gabeko aldaketa guztiak galduko dira. Segurtasunez irteteko, itzali sistema gonbidatutik."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این کار ممکن است ماشین مجازی را خراب کند و همه تغییرات ذخیره‌نشده از بین می‌روند. برای خروج ایمن، ماشین مجازی را از داخل مهمان خاموش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä voi vioittaa virtuaalikoneen, ja kaikki tallentamattomat muutokset menetetään. Jos haluat lopettaa turvallisesti, sammuta virtuaalikone vierasjärjestelmästä käsin."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maaaring masira nito ang VM at mawawala ang anumang hindi na-save na pagbabago. Para ligtas na umalis, mag-shut down mula sa guest."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci peut corrompre la VM et tous les changements non sauvegardés seront perdus. Pour quitter en toute sécurité, arrêtez la VM depuis le système invité."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto pode corromper a máquina virtual e perderanse os cambios non gardados. Para saír con seguridade, apaga o sistema desde o convidado."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "આનાથી VM બગડી શકે છે અને ન સાચવેલા બધા ફેરફારો ખોવાઈ જશે. સુરક્ષિત રીતે બહાર નીકળવા માટે, ગેસ્ટની અંદરથી શટ ડાઉન કરો."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "פעולה זו עלולה להשחית את ה-VM, וכל השינויים שלא נשמרו יאבדו. כדי לצאת בבטחה, כבה את המערכת מתוך האורח."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "इससे VM खराब हो सकती है और सहेजे न गए सभी परिवर्तन खो जाएँगे। सुरक्षित रूप से बाहर निकलने के लिए, गेस्ट के अंदर से शट डाउन करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To može oštetiti VM i sve nespremljene promjene bit će izgubljene. Za sigurno zatvaranje isključite ga iz gostujućeg sustava."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez károsíthatja a virtuális gépet, és a nem mentett módosítások elvesznek. A biztonságos kilépéshez a vendégrendszeren belül állítsa le a gépet."
          }
        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Սա կարող է վնասել վիրտուալ մեքենան, և չպահված փոփոխությունները կկորչեն։ Անվտանգ դուրս գալու համար անջատեք հյուր համակարգը նրա ներսից։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hal ini dapat merusak VM dan perubahan apa pun yang belum disimpan akan hilang. Untuk keluar dengan aman, matikan dari tamu."
          }
        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Þetta gæti skemmt sýndarvélina og allar óvistaðar breytingar glatast. Til að hætta á öruggan hátt skaltu slökkva á gestinum innan frá."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo potrebbe compromettere la VM e ogni modifica non salvata verrà persa. Per uscire in sicurezza, spegni la macchina dal sistema guest."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作により、仮想マシンを破損させる可能性があり、保存されていない変更内容が失われます。安全に終了するには、ゲストからシステム終了してください。"
