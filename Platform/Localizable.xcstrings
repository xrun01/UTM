          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMஇலிருந்து வெளியேறினால், இயங்கும் எல்லா VMகளும் முடிவுறுத்தப்படும்."
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM నుండి నిష్క్రమిస్తే, నడుస్తున్న అన్ని VMలు బలవంతంగా ముగించబడతాయి."
          }
        },
        "th" : {
