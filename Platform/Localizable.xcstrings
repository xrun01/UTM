        },
        "is" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ef þetta er virkt verða allar skrifanlegar diskmyndir læstar þegar sýndarvélin er í gangi. Skrifvarðar diskmyndir verða ekki læstar."
