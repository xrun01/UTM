    "Force kill the VM process with high risk of data corruption." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فرض إنهاء عملية الآلة الافتراضية مع خطر كبير بتلف البيانات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Erzwingen Sie das Beenden des VM-Prozesses mit hohem Risiko einer Datenbeschädigung."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forzar el cierre del proceso de la VM, con alto riesgo de corromper los datos."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "VM-prosessin pakottaminen tappamaan suurella tietojen vioittumisriskillä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
