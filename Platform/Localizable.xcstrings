    "Force kill the VM process with high risk of data corruption." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قتل عملية الآلة الافتراضية قسريًا مع خطر كبير لفساد البيانات."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Matar el proceso de la VM a la fuerza con alto riesgo de corromper los datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Force l’arrêt du processus de la VM avec un haut risque de corruption de données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forza l'interruzione del processo della VM, con un elevato rischio di compromettere dei dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのプロセスを強制終了します。高いデータ破損のリスクを伴います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 머신 프로세스를 강제 종료합니다. 매우 높은 데이터 손상 위험이 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wymuszenie zakończenia procesu maszyny wirtualnej wiąże się z dużym ryzykiem uszkodzenia danych."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Принудительное завершение процесса ВМ с высоким риском повреждения данных."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制結束虛擬機程序，會有高風險損毀資料。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "强制终止虚拟机进程 (会有高风险使数据损坏)。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強制中止虛擬機程序，很可能會導致資料損壞。"
          }
        }
      }
    },
