    "Only boot operating systems signed by Microsoft or a trusted vendor. Most major Linux distributions are supported." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Slegs selflaai bedryfstelsels wat deur Microsoft of 'n betroubare verskaffer onderteken is. Die meeste groot Linux-verspreidings word ondersteun."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قم فقط بتمهيد أنظمة التشغيل الموقعة بواسطة Microsoft أو بائع موثوق به. يتم دعم معظم توزيعات Linux الرئيسية."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কেৱল Microsoft বা এটা বিশ্বাসযোগ্য বিক্ৰেতাই স্বাক্ষৰিত অপাৰেটিং চিস্টেমসমূহ বুট কৰক। বেছিভাগ প্ৰধান Linux বিতৰণ সমৰ্থিত ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Yalnız Microsoft və ya etibarlı satıcı tərəfindən imzalanmış əməliyyat sistemlərini yükləyin. Ən böyük Linux paylamaları dəstəklənir."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Загружайце толькі аперацыйныя сістэмы, падпісаныя Microsoft або надзейным пастаўшчыком. Падтрымліваюцца большасць асноўных дыстрыбутываў Linux."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Стартирайте само операционни системи, подписани от Microsoft или доверен доставчик. Повечето основни Linux дистрибуции се поддържат."
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pokretanje samo operativnih sistema koje je potpisao Microsoft ili dobavljač od poverenja. Većina glavnih Linux distribucija je podržana."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Només sistemes operatius d'arrencada signats per Microsoft o un proveïdor de confiança. La majoria de distribucions principals de Linux són compatibles."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ang mga boot operating system lang nga gipirmahan sa Microsoft o usa ka kasaligan nga vendor. Kadaghanan sa dagkong mga distribusyon sa Linux gisuportahan."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spouštějte pouze operační systémy podepsané společností Microsoft nebo důvěryhodným dodavatelem. Podporována je většina hlavních distribucí Linuxu."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cist systemau gweithredu yn unig wedi'u llofnodi gan Microsoft neu werthwr dibynadwy. Cefnogir y rhan fwyaf o ddosbarthiadau Linux mawr."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Start kun operativsystemer, der er signeret af Microsoft eller en betroet leverandør. De fleste større Linux-distributioner understøttes."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Starten Sie nur Betriebssysteme, die von Microsoft oder einem vertrauenswürdigen Anbieter signiert sind. Die meisten großen Linux-Distributionen werden unterstützt."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Εκκινήστε μόνο λειτουργικά συστήματα υπογεγραμμένα από τη Microsoft ή έναν αξιόπιστο προμηθευτή. Υποστηρίζονται οι περισσότερες μεγάλες διανομές Linux."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Inicie únicamente sistemas operativos firmados por Microsoft o un proveedor confiable. Se admiten la mayoría de las distribuciones principales de Linux."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käivitage ainult Microsofti või usaldusväärse müüja allkirjastatud operatsioonisüsteeme. Enamik suuremaid Linuxi distributsioone on toetatud."
          }
        },
        "eu" : {
          "stringUnit" : {
