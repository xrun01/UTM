        },
        "hy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Եթե միացված է, վիրտուալ մեքենայի աշխատանքի ընթացքում կկողպվեն սկավառակի բոլոր այն պատկերները, որոնց վրա հնարավոր է գրել։ Միայն կարդալու համար նախատեսված պատկերները չեն կողպվի։"
