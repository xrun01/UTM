    "Cannot find AltServer to enable JIT. You cannot run VMs until JIT is enabled." : {
      "comment" : "UTMData",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan nie AltServer vind om JIT te aktiveer nie. Jy kan nie VM's laat loop voordat JIT geaktiveer is nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن العثور على AltServer لتمكين JIT. لا يمكنك تشغيل الآلات الافتراضية حتى يتم تمكين JIT."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JIT সামৰ্থবান কৰিবলে AltServer বিচাৰি পোৱা নগ'ল। JIT সামৰ্থবান নোহোৱালৈকে আপুনি VMs চলাব নোৱাৰে।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JIT-i aktivləşdirmək üçün AltServeri tapmaq mümkün deyil. JIT aktivləşdirilənə qədər VM-ləri işə sala bilməzsiniz."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Немагчыма знайсці AltServer для ўключэння JIT. Вы не можаце запускаць віртуальныя машыны, пакуль JIT не ўключаны."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не може да се намери AltServer за активиране на JIT. Не можете да стартирате виртуални машини, докато JIT не е активиран."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "JIT সক্ষম করতে AltServer খুঁজে পাওয়া যাচ্ছে না। JIT সক্ষম না হওয়া পর্যন্ত আপনি VM চালাতে পারবেন না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nije moguće pronaći AltServer da omogući JIT. Ne možete pokrenuti VM dok nije omogućen JIT."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No es pot trobar AltServer per habilitar JIT. No podeu executar màquines virtuals fins que el JIT estigui habilitat."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dili makit-an ang AltServer aron mahimo ang JIT. Dili ka makadagan sa mga VM hangtod nga ma-enable ang JIT."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nelze najít AltServer pro povolení JIT. Nemůžete spouštět virtuální počítače, dokud není povoleno JIT."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Methu dod o hyd i AltServer i alluogi JIT. Ni allwch redeg VMs nes bod JIT wedi'i alluogi."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kan ikke finde AltServer for at aktivere JIT. Du kan ikke køre VM'er, før JIT er aktiveret."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AltServer zum Aktivieren von JIT wurde nicht gefunden. VMs können erst ausgeführt werden, wenn JIT aktiviert ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Δεν είναι δυνατή η εύρεση του AltServer για ενεργοποίηση του JIT. Δεν μπορείτε να εκτελέσετε VM μέχρι να ενεργοποιηθεί το JIT."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se encuentra AltServer para habilitar JIT. No puedes ejecutar VMs hasta que JIT esté habilitado."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "AltServerit ei leitud JIT-i lubamiseks. VM-e ei saa käivitada enne, kui JIT on lubatud."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ezin da aurkitu AltServer JIT gaitzeko. Ezin duzu VM-ak exekutatu JIT gaitu arte."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "نمی توان AltServer را برای فعال کردن JIT پیدا کرد. تا زمانی که JIT فعال نشود، نمی توانید ماشین های مجازی را اجرا کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "JIT:n käyttöönottoon tarvittavaa AltServeria ei löydy. Et voi suorittaa virtuaalikoneita, ennen kuin JIT on käytössä."
          }
        },
        "fil" : {
          "stringUnit" : {
