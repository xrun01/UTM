          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM ସମାପ୍ତ କରନ୍ତୁ ଏବଂ ଚାଲୁଥିବା ସମସ୍ତ VM ବନ୍ଦ କରନ୍ତୁ।"
