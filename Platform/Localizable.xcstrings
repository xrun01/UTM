    "Choose whether UTM saves the state of running virtual machines or requests that their guest operating systems shut down when UTM quits." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر ما إذا كان UTM يحفظ حالة تشغيل الأجهزة الافتراضية أو يطلب إيقاف تشغيل أنظمة التشغيل الضيف الخاصة بها عند إنهاء UTM."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie, ob UTM den Status laufender virtueller Maschinen speichert oder anfordert, dass deren Gastbetriebssysteme heruntergefahren werden, wenn UTM beendet wird."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elija si UTM guarda el estado de las máquinas virtuales en ejecución o solicita que sus sistemas operativos invitados se apaguen cuando UTM se cierra."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Valitse, tallentaako UTM käynnissä olevien virtuaalikoneiden tilan vai pyytääkö niiden vieraskäyttöjärjestelmien sammuttamista, kun UTM sulkeutuu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez si UTM enregistre l'état des machines virtuelles en cours d'exécution ou demande que leurs systèmes d'exploitation invités s'arrêtent à la fermeture d'UTM."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Scegli se UTM salva lo stato delle macchine virtuali in esecuzione o richiede l'arresto dei sistemi operativi guest alla chiusura di UTM."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "UTM が実行中の仮想マシンの状態を保存するか、UTM の終了時にゲスト オペレーティング システムのシャットダウンを要求するかを選択します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "UTM이 실행 중인 가상 머신의 상태를 저장할지 아니면 UTM이 종료될 때 게스트 운영 체제를 종료하도록 요청할지 선택합니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz, czy UTM ma zapisywać stan uruchomionych maszyn wirtualnych, czy żądać zamknięcia ich systemów operacyjnych gościa po zamknięciu UTM."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите, будет ли UTM сохранять состояние запущенных виртуальных машин или запрашивать закрытие их гостевых операционных систем при выходе из UTM."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選擇 UTM 是保存正在運行的虛擬機器的狀態，還是請求在 UTM 退出時關閉其來賓作業系統。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择 UTM 是保存正在运行的虚拟机的状态，还是请求在 UTM 退出时关闭其来宾操作系统。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選擇 UTM 是保存正在運行的虛擬機器的狀態，還是請求在 UTM 退出時關閉其來賓作業系統。"
          }
        }
      }
    },
