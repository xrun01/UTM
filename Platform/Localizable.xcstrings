        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ako je omogućeno, sve slike pogona za pisanje bit će zaključane kada VM radi. Slike pogona samo za čitanje neće biti zaključane."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha engedélyezve van, a virtuális gép futása közben az összes írható lemezkép zárolva lesz. A csak olvasható lemezképek nem lesznek zárolva."
