    "A drive cannot be read only once a snapshot has been taken of it." : {
      "comment" : "UTMAppleDiskImage",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يمكن قراءة محرك الأقراص إلا بعد التقاط لقطة له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ein Laufwerk kann erst dann gelesen werden, wenn ein Snapshot davon erstellt wurde."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una unidad no se puede leer sólo una vez que se ha tomado una instantánea de ella."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Asemaa ei voi lukea vasta, kun siitä on otettu tilannekuva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Un lecteur ne peut pas être lu uniquement une fois qu'un instantané en a été pris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Non è possibile leggere un'unità solo dopo averne scattata un'istantanea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ドライブのスナップショットが作成された後のみ、ドライブを読み取ることはできません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "드라이브의 스냅샷이 생성된 후에만 드라이브를 읽을 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dysku nie można odczytać dopiero po wykonaniu jego migawki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Диск не может быть прочитан только после того, как был сделан его снимок."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一旦製作磁碟快照，將無法將磁碟設為唯讀。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在创建驱动器的快照后，无法设置驱动器为只读。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "僅在為驅動器拍攝快照後才能讀取該驅動器。"
          }
        }
      }
    },
    "A drive cannot be resized once a snapshot has been taken of it." : {
      "comment" : "UTMAppleDiskImage",
