        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप इस VM को किसी दूसरी जगह ले जाना चाहते हैं? इससे डेटा नई जगह पर कॉपी होगा, मूल जगह से डिलीट होगा और फिर एक शॉर्टकट बनेगा।"
