    "Space cannot be reclaimed from a drive while it holds snapshots or a suspended state." : {
      "comment" : "UTMData",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ruimte kan nie van 'n skyf herwin word terwyl dit momentopnames of 'n opgeskorte toestand bevat nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استعادة المساحة من القرص ما دام يحتوي على لقطات أو حالة إسبات."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ড্ৰাইভত স্নেপশ্বট বা স্থগিত অৱস্থা থাকিলে ইয়াৰ খালী ঠাই ঘূৰাই ল'ব নোৱাৰি।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diskdə anlıq görüntülər və ya yuxu rejimi vəziyyəti saxlanılarkən onun boş sahəsini geri qaytarmaq olmaz."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Немагчыма вызваліць месца на дыску, пакуль ён захоўвае здымкі або прыпынены стан."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Мястото на диска не може да се освободи, докато дискът съдържа моментни снимки или състояние на приспиване."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কোনো ড্রাইভে স্ন্যাপশট বা স্থগিত অবস্থা থাকলে সেই ড্রাইভ থেকে জায়গা ফেরত পাওয়া যায় না।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prostor na disku ne može se osloboditi dok se na njemu nalaze snimci ili suspendirano stanje."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'espai no es pot recuperar d'una unitat mentre conté instantànies o un estat suspès."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dili mabawi ang espasyo gikan sa drive samtang adunay kini mga snapshot o gisuspinde nga kahimtang."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Místo na disku nelze uvolnit, dokud disk obsahuje snímky nebo stav uspání."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ni ellir adennill lle o yriant tra bo'n dal cipluniau neu gyflwr atal dros dro."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plads kan ikke genvindes fra et drev, mens det indeholder snapshots eller en dvaletilstand."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von einem Laufwerk kann kein Speicherplatz zurückgewonnen werden, solange es Snapshots oder einen ausgesetzten Zustand enthält."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Δεν είναι δυνατή η ανάκτηση χώρου από μια μονάδα δίσκου όσο περιέχει στιγμιότυπα ή κατάσταση αναστολής."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se puede recuperar espacio de una unidad mientras contiene instantáneas o un estado suspendido."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draivilt ei saa ruumi vabastada, kui sellel on hetktõmmised või uinutatud olek."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezin da unitate batean lekua berreskuratu bat-bateko argazkiak edo esekitako egoera bat dituen bitartean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تا وقتی درایو اسنپ‌شات یا حالت تعلیق دارد، نمی‌توان فضای آن را آزاد کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asemalta ei voi vapauttaa tilaa, kun siinä on tilannevedoksia tai lepotilan tallennettu tila."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hindi ma-reclaim ang space mula sa isang drive habang may laman itong mga snapshot o naka-suspend na estado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'espace d'un lecteur ne peut pas être récupéré tant qu'il contient des instantanés ou un état suspendu."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non se pode recuperar espazo dunha unidade mentres contén instantáneas ou un estado suspendido."
          }
        },
        "gu" : {
          "stringUnit" : {
            "state" : "translated",
