    "Shared directories in macOS VMs are only available in macOS 13 and later." : {
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gedeelde vouers in macOS-VM's is slegs beskikbaar in macOS 13 en nuwer."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدلائل المشتركة في آلات macOS الافتراضية متاحة فقط في macOS 13 أو إصدار أحدث."
          }
        },
        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS VM ত অংশীদাৰী ডাইৰেক্টৰী কেৱল macOS 13 বা তাৰ পিছৰ সংস্কৰণত উপলব্ধ।"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS VM-lərində paylaşılan kataloqlar yalnız macOS 13 və sonrakı versiyalarda mövcuddur."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Агульныя каталогі ў віртуальных машынах macOS даступныя толькі ў macOS 13 і пазнейшых версіях."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Споделените директории във виртуални машини macOS са налични само в macOS 13 и по-нови версии."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS VM-এ শেয়ার করা ডিরেক্টরি শুধুমাত্র macOS 13 অথবা এর পরবর্তী ভার্সনে উপলব্ধ।"
          }
        },
        "bs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dijeljeni direktoriji u macOS virtuelnim mašinama dostupni su samo na macOS-u 13 ili novijem."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Els directoris compartits de les màquines virtuals macOS només estan disponibles a macOS 13 o posterior."
          }
        },
        "ceb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang gipaambit nga mga direktoryo sa macOS VM anaa ra sa macOS 13 o mas bag-o."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sdílené adresáře ve virtuálních počítačích macOS jsou k dispozici pouze v macOS 13 a novějších."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dim ond mewn macOS 13 ac yn ddiweddarach y mae cyfeiriaduron a rennir mewn VMs macOS ar gael."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Delte mapper i macOS-VM'er er kun tilgængelige i macOS 13 og nyere."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Freigegebene Ordner in macOS-VMs sind nur unter macOS 13 oder neuer verfügbar."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Οι κοινόχρηστοι κατάλογοι σε εικονικές μηχανές macOS είναι διαθέσιμοι μόνο σε macOS 13 ή νεότερη έκδοση."
