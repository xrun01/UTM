        },
        "mt" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' huwa konness ma' '%2$@'. Trid tiskonnettjaha u tqabbadha ma' din il-magna virtwali minflok?"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' သည် '%2$@' နှင့် ချိတ်ဆက်ထားသည်။ ၎င်းကို ချိတ်ဆက်မှုဖြုတ်ပြီး ၎င်းအစား ၎င်းကို ဤ virtual machine သို့ ချိတ်ဆက်လိုပါသလား။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' er koblet til '%2$@'. Vil du koble den fra og koble den til denne virtuelle maskinen i stedet?"
          }
        },
        "ne" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' मा जोडिएको छ। के तपाइँ यसलाई विच्छेदन र यसको सट्टा यो भर्चुअल मेसिनमा जडान गर्न चाहनुहुन्छ?"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' is verbonden met '%2$@'. Wilt u de verbinding verbreken en in plaats daarvan verbinden met deze virtuele machine?"
          }
        },
        "or" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' ସହିତ ସଂଯୁକ୍ତ | ଆପଣ ଏହାକୁ ସଂଯୋଗ ବିଚ୍ଛିନ୍ନ କରି ଏହା ବଦଳରେ ଏହି ଭର୍ଚୁଆଲ୍ ମେସିନ୍ ସହିତ ସଂଯୋଗ କରିବାକୁ ଚାହୁଁଛନ୍ତି କି?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@” jest połączone z „%2$@”. Czy zamiast tego chcesz go odłączyć i podłączyć do tej maszyny wirtualnej?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' está conectado a '%2$@'. Deseja desconectá-lo e conectá-lo a esta máquina virtual?"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@” este conectat la „%2$@”. Doriți să îl deconectați și să îl conectați la această mașină virtuală?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' подключен к '%2$@'. Вы хотите отключить его и вместо этого подключить к этой виртуальной машине?"
          }
        },
        "sd" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' سان ڳنڍيل آهي. ڇا توھان ان کي ڊسڪنيڪٽ ڪرڻ چاھيو ٿا ۽ ان جي بدران ھن ورچوئل مشين سان ڳنڍڻ چاھيو ٿا؟"
          }
        },
        "si" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' වෙත සම්බන්ධ වී ඇත. ඔබට එය විසන්ධි කර ඒ වෙනුවට මෙම අතථ්‍ය යන්ත්‍රයට සම්බන්ධ කිරීමට අවශ්‍යද?"
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' je pripojený k '%2$@'. Chcete ho odpojiť a pripojiť k tomuto virtuálnemu stroju?"
          }
        },
        "sl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' je povezan z '%2$@'. Ali ga želite prekiniti in ga namesto tega povezati s tem virtualnim strojem?"
          }
        },
        "sq" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"%1$@\" është i lidhur me \"%2$@\". Dëshiron ta shkëputësh dhe ta lidhësh me këtë makinë virtuale?"
          }
        },
        "sr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "„%1$@“ је повезан са „%2$@“. Да ли желите да га искључите и повежете са овом виртуелном машином уместо тога?"
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' är kopplad till '%2$@'. Vill du koppla bort den och ansluta den till den här virtuella maskinen istället?"
          }
        },
        "sw" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' imeunganishwa kwa '%2$@'. Je, ungependa kuikata na kuiunganisha kwa mashine hii pepe badala yake?"
          }
        },
        "ta" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' உடன் இணைக்கப்பட்டுள்ளது. அதைத் துண்டித்துவிட்டு, அதற்குப் பதிலாக இந்த மெய்நிகர் இயந்திரத்துடன் இணைக்க விரும்புகிறீர்களா?"
          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@'కి కనెక్ట్ చేయబడింది. మీరు దీన్ని డిస్‌కనెక్ట్ చేసి, బదులుగా ఈ వర్చువల్ మెషీన్‌కి కనెక్ట్ చేయాలనుకుంటున్నారా?"
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' เชื่อมต่อกับ '%2$@' คุณต้องการยกเลิกการเชื่อมต่อและเชื่อมต่อกับเครื่องเสมือนนี้แทนหรือไม่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@', '%2$@'ye bağlı. Bağlantısını kesip bunun yerine bu sanal makineye bağlamak istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' підключено до '%2$@'. Від’єднати його та під’єднати до цієї віртуальної машини?"
          }
        },
        "ur" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' '%2$@' سے منسلک ہے۔ کیا آپ اسے منقطع کرکے اس کی بجائے اس ورچوئل مشین سے جوڑنا چاہتے ہیں؟"
          }
        },
        "uz" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "\"%1$@\" \"%2$@\" ga ulangan. Uni uzib, o‘rniga ushbu virtual mashinaga ulamoqchimisiz?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "'%1$@' được kết nối với '%2$@'. Bạn có muốn ngắt kết nối nó và kết nối nó với máy ảo này không?"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」已連接至「%2$@」。你要中斷連線並連接至此虛擬機嗎？"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%1$@”已连接到“%2$@”。你要断开连接并将其连接到此虚拟机吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "“%1$@”已連接到“%2$@”。您想斷開連接並將其連接到該虛擬機器嗎？"
          }
        }
      }
    },
