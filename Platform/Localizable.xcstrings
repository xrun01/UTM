        },
        "ceb" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aron ma-access ang gipaambit nga direktoryo, ang bisita nga OS kinahanglan adunay mga drayber sa Virtiofs nga na-install. Mahimo nimong ipadagan ang `sudo mount -t virtiofs share /path/to/share` aron i-mount sa agianan sa bahin."
