    "Tells the VM process to shut down with risk of data corruption. This simulates holding down the power button on a PC." : {
      "comment" : "VMDisplayWindowController",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يخبر عملية الآلة الافتراضية بإيقاف التشغيل مع خطر تلف البيانات. هذا يحاكي الضغط مع الاستمرار على زر الطاقة في الكمبيوتر الشخصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Weist den VM-Prozess an, herunterzufahren, da das Risiko einer Datenbeschädigung besteht. Dies simuliert das Gedrückthalten des Netzschalters an einem PC."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indica al proceso de la VM que se apague, con riesgo de corromper los datos. Esto simula mantener presionado el botón de apagado en una PC."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Käskee VM-prosessin sammumaan tietojen vioittumisen vaaran vuoksi. Tämä simuloi tietokoneen virtapainikkeen pitämistä painettuna."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indique au processus de la VM de s’arrêter avec un risque de corruption des données. Cela simule un appui prolongé sur le bouton d’alimentation du PC."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informa il processo della VM di arrestarsi con il rischio di compromettere dei dati. Questo simula la pressione prolungata del tasto di accensione di un PC."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンのプロセスにデータ破損のリスクを伴うシステム終了を指示します。これにより、PCの電源ボタン長押しをシミュレートします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 머신 프로세스에 종료 신호를 보냅니다. 데이터가 손상될 위험이 있습니다. 이는 PC의 전원 버튼을 길게 누르는 행동을 흉내냅니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nakazuje procesowi maszyny wirtualnej wyłączenie z ryzykiem uszkodzenia danych. Symuluje to przytrzymanie przycisku zasilania w komputerze PC."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дает процессу ВМ команду на выключение с риском повреждения данных. Это имитирует удержание кнопки питания на ПК."
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讓虛擬機程序關機，會有風險損毀資料。此操作模擬了在 PC 上長按電源按鈕。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通知虚拟机进程关闭 (存在数据损坏的风险)。这一操作模拟了按住 PC 上的电源按钮。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告訴虛擬機器程序關機，可能導致資料損壞。模擬長按 PC 的關機鍵。"
          }
        }
      }
    },
    "Terminate UTM and stop all running VMs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنهاء UTM وإيقاف جميع الآلات الافتراضية الجارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Beenden Sie UTM und stoppen Sie alle laufenden VMs."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Termine UTM y detenga todas las máquinas virtuales en ejecución."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Lopeta UTM ja pysäytä kaikki käynnissä olevat virtuaalikoneet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quitte UTM et arrête toutes les VM en cours d’exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termina UTM e tutte le macchine virtuali in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTMを終了し、すべての実行中の仮想マシンを停止します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "UTM을 종료하고 실행 중인 모든 가상 머신을 중지합니다."
          }
        },
        "pl" : {
