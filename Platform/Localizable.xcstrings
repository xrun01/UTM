    "Closing a VM without properly shutting it down could result in data loss." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يؤدي إغلاق آلة افتراضية دون إيقافها بشكل صحيح إلى فقدان البيانات."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiusura di una VM senza il corretto spegnimento potrebbe comportare perdita di dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仮想マシンを適切にシステム終了せずに閉じると、データが失われる可能性があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가상 머신을 정상적으로 종료하지 않으면 데이터 손상이 발생할 수 있습니다."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zamknięcie maszyny wirtualnej bez poprawnego jej wyłączenia może poskukować utratą danych"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在未正確關機的情況下關閉虛擬機可能會引致資料遺失。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在不正确关闭电源的情况下关闭虚拟机可能会导致数据丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不先正確關機而直接關閉虛擬機，可能導致資料遺失。"
          }
        }
      }
    },
