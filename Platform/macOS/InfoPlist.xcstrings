        "as" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "মাইক্ৰ'ফোনৰ পৰা ৰেকৰ্ড কৰিবলৈ যিকোনো ভাৰ্চুৱেল মেচিনৰ বাবে অনুমতিৰ প্ৰয়োজন।"
