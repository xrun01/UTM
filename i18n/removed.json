  {
    "table": "Localizable",
    "key": "If checked, the drive image will be stored with the VM.",
    "source": "If checked, the drive image will be stored with the VM.",
    "translations": {
      "ar": {
        "stringUnit": {
          "state": "translated",
          "value": "إذا تم تحديده، ستُخزن صورة القرص مع الآلة الافتراضية."
        }
      },
      "de": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Wenn diese Option aktiviert ist, wird das Laufwerksimage mit der VM gespeichert."
        }
      },
      "es-419": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Si está marcada, la imagen de la unidad se almacenará con la VM."
        }
      },
      "fi": {
        "stringUnit": {
          "state": "needs_review",
          "value": "Jos tämä on valittuna, aseman kuva tallennetaan virtuaalikoneeseen."
        }
      },
      "fr": {
        "stringUnit": {
          "state": "translated",
          "value": "Si coché, l’image de lecteur sera stockée avec la VM."
        }
      },
      "it": {
        "stringUnit": {
          "state": "translated",
          "value": "Se attivo, l'immagine disco sarà salvata insieme alla VM."
        }
      },
      "ja": {
        "stringUnit": {
          "state": "translated",
          "value": "チェックを入れると、ドライブイメージが仮想マシンに保存されます。"
        }
      },
      "ko": {
        "stringUnit": {
          "state": "translated",
          "value": "활성화하면 드라이브 이미지가 가상 머신과 함께 저장됩니다."
        }
      },
      "pl": {
        "stringUnit": {
